/* 自绘日期弹层 · 共用样式
   被 pages/name/name.wxss 与 pages/analyze/analyze.wxss 通过 @import 引用。
   只用 view / scroll-view，不依赖原生 picker。 */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(22, 24, 26, 0.42);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--card);
  border-top: 1rpx solid var(--line-strong);
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 40rpx;
  border-bottom: 1rpx solid var(--line);
}

.sheet-title {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.sheet-act {
  font-size: 27rpx;
  color: var(--ink-3);
  padding: 6rpx 8rpx;
}

.sheet-ok {
  color: var(--cinnabar);
}

/* 年 / 月 / 日 三个列头，与下面三列对齐 */
.sheet-units {
  display: flex;
  padding: 14rpx 0 6rpx;
}

.sheet-unit {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.sheet-cols {
  display: flex;
  height: 400rpx;
}

.sheet-col {
  flex: 1;
  height: 100%;
  -webkit-overflow-scrolling: touch;
}

.sheet-item {
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink-2);
}

.sheet-item.on {
  color: var(--cinnabar);
  background: var(--cinnabar-bg);
  font-weight: 500;
}
