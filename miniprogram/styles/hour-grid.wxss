/* 十二时辰格 · 共用样式
   被 pages/name/name.wxss 与 pages/analyze/analyze.wxss 通过 @import 引用。
   四列三行，不依赖原生 picker。 */

.hour-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.hour-cell {
  width: 25%;
  box-sizing: border-box;
  padding: 6rpx;
}

.hour-cell > text {
  display: block;
  text-align: center;
}

.hour-name {
  font-family: var(--serif);
  font-size: 30rpx;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 12rpx 0 2rpx;
}

.hour-span {
  font-size: 20rpx;
  color: var(--ink-3);
  padding: 2rpx 0 10rpx;
  border: 1rpx solid var(--line);
  border-top: none;
  border-radius: 0 0 var(--r-sm) var(--r-sm);
  margin-top: -1rpx;
}

.hour-cell.on .hour-name {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}

.hour-cell.on .hour-span {
  border-color: var(--ink);
  color: var(--ink);
}
