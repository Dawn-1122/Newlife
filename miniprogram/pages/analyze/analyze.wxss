.header {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

.form-card {
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: var(--ink-2);
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--ink);
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--ink);
}

.chip-row {
  display: flex;
  gap: 16rpx;
  flex: 1;
  justify-content: flex-end;
}

.chip {
  padding: 12rpx 28rpx;
  border-radius: 3rpx;
  background: var(--paper-deep);
  color: var(--ink-2);
  font-size: 26rpx;
}

.chip.active {
  background: var(--ink);
  color: var(--card);
}

.footer-note {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.footer-note text {
  font-size: 22rpx;
  color: var(--ink-3);
}
