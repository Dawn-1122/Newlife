/* 释名 · 填姓名（可选补生辰） */

/* 日期弹层与时辰下拉的样式在 app.wxss（全局必加载，不靠 @import） */

.header {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

.form-card {
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

/* 纵向布局：标签在上，选项在下（12 格时辰挤不进一行） */
.form-item-col {
  display: block;
}

.form-label {
  font-size: 28rpx;
  color: var(--ink-2);
  width: 160rpx;
  flex-shrink: 0;
}

.form-label-block {
  display: block;
  width: auto;
  margin-bottom: 16rpx;
}

.form-hint {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.hint-block {
  display: block;
  margin-top: 14rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--ink);
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.picker-value.placeholder {
  color: var(--line-strong);
}

/* 可点击字段右侧的小箭头，暗示"这里能点开" */
.field-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: var(--line-strong);
  line-height: 1;
}

.chip-row {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

/* 换行间距用 margin 而非 gap，兼容旧 WebView */
.chip-row .chip + .chip {
  margin-left: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  border-radius: 3rpx;
  background: var(--paper-deep);
  color: var(--ink-2);
  font-size: 26rpx;
}

.chip.active {
  background: var(--ink);
  color: var(--card);
}

.footer-note {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.footer-note text {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 副入口：不做成按钮 —— 主要动作只有一个（开始释名） */
.compare-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 24rpx 4rpx;
  border-top: 1rpx solid var(--line);
}

.compare-entry:active {
  opacity: 0.7;
}

.compare-entry-text {
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: var(--ink-2);
}

.compare-entry-arrow {
  font-size: 26rpx;
  color: var(--ink-3);
}
