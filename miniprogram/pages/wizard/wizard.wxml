<view class="page">
  <!-- 窄幅泼墨页头 -->
  <view class="band">
    <image class="band-img" src="/images/ink-band.jpg" mode="widthFix" />
  </view>

  <view class="head">
    <view class="head-title">挑一种感觉</view>
    <view class="head-meta">{{metaText}}</view>
  </view>

  <!-- 感觉卡：8 张，一对一映射到一个风格 + 两个寓意 -->
  <view class="feel-grid">
    <view
      class="feel-card {{item.selected ? 'active' : ''}}"
      wx:for="{{feelings}}"
      wx:key="code"
      bindtap="onFeelTap"
      data-code="{{item.code}}"
    >
      <view class="feel-title">{{item.title}}</view>
      <view class="feel-imagery">{{item.imagery}}</view>
    </view>
  </view>

  <!-- 避讳字（低频，默认收起） -->
  <view class="avoid">
    <view class="avoid-toggle" bindtap="onToggleAvoid">
      <text class="avoid-toggle-text">有要避开的字</text>
      <text class="avoid-toggle-tail">{{avoidOpen ? '收起' : '展开'}}</text>
    </view>
    <view class="avoid-body" wx:if="{{avoidOpen}}">
      <input
        class="avoid-input"
        placeholder="多个字用逗号、顿号或空格分隔，如：伟,强"
        value="{{avoidChars}}"
        bindinput="onAvoidInput"
      />
      <view class="avoid-tip">避讳字会在候选与组合阶段被硬剔除，例如家族长辈用字。</view>
    </view>
  </view>

  <!-- 主行动 -->
  <view class="foot">
    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}">
      {{tab === 'prenatal' ? '查看孕期参考' : '生成名字'}}
    </button>
    <view class="foot-note" wx:if="{{selected}}">已选「{{selectedTitle}}」</view>
    <view class="foot-note" wx:else>不选也可以，将给出各方向的名字</view>
  </view>
</view>
