<view class="page">
  <view class="head">
    <view class="head-title">定偏好</view>
    <view class="head-meta">{{metaText}}</view>
  </view>

  <view class="intro">每个名字都从典籍里来，有出处、有讲头</view>

  <!-- ① 期许：≤3，按 7 个方向分组。一句话定「希望孩子成为什么样的人」 -->
  <view class="block">
    <view class="block-head">
      <text class="block-title">期许</text>
      <text class="block-tail">{{meaningCount}}/{{meaningMax}}</text>
    </view>
    <view class="block-note">我希望 TA —— 挑几件最看重的事</view>
    <view class="group" wx:for="{{meaningGroups}}" wx:for-item="grp" wx:key="code">
      <view class="group-head">
        <text class="group-title">{{grp.title}}</text>
        <text class="group-sub">{{grp.subtitle}}</text>
      </view>
      <view class="tag-row">
        <view
          class="tag {{item.selected ? 'active' : ''}}"
          wx:for="{{grp.meanings}}"
          wx:for-item="item"
          wx:key="code"
          bindtap="onMeaningTap"
          data-code="{{item.code}}"
        >{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- ② 气质：单选。一个词定整体调性 -->
  <view class="block">
    <view class="block-head">
      <text class="block-title">气质</text>
      <text class="block-tail">{{styleCode ? '已选' : '单选，可跳过'}}</text>
    </view>
    <view class="tag-row">
      <view
        class="tag {{item.selected ? 'active' : ''}}"
        wx:for="{{styles}}"
        wx:key="code"
        bindtap="onStyleTap"
        data-code="{{item.code}}"
      >{{item.name}}</view>
    </view>
    <!-- 选中后说明这个气质用什么样的字：不解释，用户只能凭标签名猜 -->
    <view class="style-hint" wx:if="{{styleNote}}">{{styleNote}}</view>
  </view>

  <!-- 取名之法（直接推荐/先字后典/先典后字）已下线：
       三条路径里两条要用户先做一件他还没能力判断的事（挑 300 多个裸字、
       判断哪部典籍合适），而出处偏好本来就该由「气质」承担。
       现在只保留一条路：按期许与气质直接荐名。 -->


  <!-- 避讳字（低频，默认收起）。孕期只出历法统计、不出名字，
       避讳字对结果没有任何影响，所以这一块不出现。 -->
  <view class="avoid" wx:if="{{tab !== 'prenatal'}}">
    <view class="avoid-toggle" bindtap="onToggleAvoid">
      <text class="avoid-toggle-text">有要避开的字</text>
      <text class="avoid-toggle-tail">{{avoidOpen ? '收起' : '展开'}}</text>
    </view>
    <view class="avoid-body" wx:if="{{avoidOpen}}">
      <input
        class="avoid-input"
        placeholder="多个字用逗号、顿号或空格分隔，如：伟,强"
        value="{{avoidChars}}"
        bindinput="onAvoidInput"
      />
      <view class="avoid-tip">避讳字会在候选与组合阶段被硬剔除，例如家族长辈用字。</view>
    </view>
  </view>

  <!-- 主行动 -->
  <view class="foot">
    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}">
      {{tab === 'prenatal' ? '查看孕期参考' : '生成名字'}}
    </button>
    <view class="foot-note" wx:if="{{tab === 'prenatal'}}">预产期给的是范围参考</view>
    <view class="foot-note" wx:else>什么都不选也行，会按韵味给出各方向的名字</view>

    <!-- 今日批次（起名与换一批共用）。用完就在这里给转发入口，
         不让用户点进去再被拦在结果页。 -->
    <view class="quota-row" wx:if="{{quotaLeft <= 0}}">
      <text class="quota-row-text">今天的 {{quotaFree}} 批用完了</text>
      <button class="quota-row-btn" open-type="share" disabled="{{shareLeft <= 0}}"
      >{{shareLeft > 0 ? '转发 +' + shareBonus + ' 批（还可领 ' + shareLeft + ' 次）' : '今天的转发次数已领完'}}</button>
    </view>
    <view class="foot-note" wx:else>今天还能看 {{quotaLeft}} 批（起名或换一批各算 1 批）</view>
  </view>
</view>
