<view class="page">
  <view class="head">
    <view class="head-title">定偏好</view>
    <view class="head-meta">{{metaText}}</view>
  </view>

  <view class="intro">每个名字都从典籍里来，有出处、有讲头</view>

  <!-- ① 期许：≤3，按 7 个方向分组。一句话定「希望孩子成为什么样的人」 -->
  <view class="block">
    <view class="block-head">
      <text class="block-title">期许</text>
      <text class="block-tail">{{meaningCount}}/{{meaningMax}}</text>
    </view>
    <view class="block-note">我希望 TA —— 挑几件最看重的事</view>
    <view class="group" wx:for="{{meaningGroups}}" wx:for-item="grp" wx:key="code">
      <view class="group-head">
        <text class="group-title">{{grp.title}}</text>
        <text class="group-sub">{{grp.subtitle}}</text>
      </view>
      <view class="tag-row">
        <view
          class="tag {{item.selected ? 'active' : ''}}"
          wx:for="{{grp.meanings}}"
          wx:for-item="item"
          wx:key="code"
          bindtap="onMeaningTap"
          data-code="{{item.code}}"
        >{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- ② 气质：单选。一个词定整体调性 -->
  <view class="block">
    <view class="block-head">
      <text class="block-title">气质</text>
      <text class="block-tail">{{styleCode ? '已选' : '单选，可跳过'}}</text>
    </view>
    <view class="tag-row">
      <view
        class="tag {{item.selected ? 'active' : ''}}"
        wx:for="{{styles}}"
        wx:key="code"
        bindtap="onStyleTap"
        data-code="{{item.code}}"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- ③ 路径（未出生只有直接推荐：预产期给的是范围参考，不吃先字/先典） -->
  <view class="block" wx:if="{{tab === 'postnatal'}}">
    <view class="block-head">
      <text class="block-title">取名之法</text>
    </view>
    <view class="path-row">
      <view
        class="path-card {{path === item.code ? 'active' : ''}}"
        wx:for="{{paths}}"
        wx:key="code"
        bindtap="onPathTap"
        data-code="{{item.code}}"
      >
        <view class="path-name">{{item.name}}</view>
        <view class="path-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 路径 · 先字后典 -->
  <view class="block" wx:if="{{tab === 'postnatal' && path === 'chars'}}">
    <view class="block-head">
      <text class="block-title">可选字</text>
      <text class="block-tail" wx:if="{{pickLoaded}}">已选 {{pickedCount}}/{{pickMax}}</text>
    </view>

    <view class="pick-hint" wx:if="{{pickLoading}}">正在算这个姓氏下哪些字组得出名字…</view>

    <block wx:elif="{{pickLoaded}}">
      <view class="pick-stat">
        池内 {{pickTotal}} 字 · 本姓组得出名字 {{pickFeasible}} 字
        <text wx:if="{{genChar}}"> · 辈字「{{genChar}}」固定第二字</text>
      </view>
      <view class="pick-warn" wx:if="{{pickStale}}">
        偏好改过了，字表还是上一版的。
        <text class="pick-warn-act" bindtap="onReloadPick">重新载入</text>
      </view>

      <view class="char-grid">
        <view
          class="char-cell {{item.picked ? 'active' : ''}}"
          wx:for="{{charView}}"
          wx:key="char"
          bindtap="onCharTap"
          data-idx="{{index}}"
        >
          <view class="char-glyph">{{item.char}}</view>
          <view class="char-sub">{{item.name_hits}} 名{{item.family ? ' · ' + item.family : ''}}</view>
        </view>
      </view>

      <view class="more" wx:if="{{charFiltered > charVisible}}" bindtap="onMoreChars">
        还有 {{charFiltered - charVisible}} 个 · 显示更多
      </view>

      <view class="picked-bar" wx:if="{{pickedCount}}">
        <text class="picked-text">已选 {{pickedText}}</text>
        <text class="picked-clear" bindtap="onClearPicked">清空</text>
      </view>
      <view class="block-note" wx:else>
        每个字下面写着「这个姓氏下它能组出多少个名字」——只列真的能用的字。
      </view>
    </block>

    <view class="pick-hint" wx:else>点「先字后典」后载入可选字。</view>
  </view>

  <!-- 路径 · 先典后字 -->
  <view class="block" wx:if="{{tab === 'postnatal' && path === 'sources'}}">
    <view class="block-head">
      <text class="block-title">典籍范围</text>
      <text class="block-tail">{{sourceCount}} 项</text>
    </view>
    <view class="tag-row">
      <view
        class="tag {{item.selected ? 'active' : ''}}"
        wx:for="{{sources}}"
        wx:key="code"
        bindtap="onSourceTap"
        data-code="{{item.code}}"
      >{{item.name}}</view>
    </view>
    <view class="block-note">
      名字只会从这里选的典籍里取。字源四部（周易/山海经/本草纲目/神农本草经）归在「经史子集」。
    </view>
  </view>

  <!-- 避讳字（低频，默认收起） -->
  <view class="avoid">
    <view class="avoid-toggle" bindtap="onToggleAvoid">
      <text class="avoid-toggle-text">有要避开的字</text>
      <text class="avoid-toggle-tail">{{avoidOpen ? '收起' : '展开'}}</text>
    </view>
    <view class="avoid-body" wx:if="{{avoidOpen}}">
      <input
        class="avoid-input"
        placeholder="多个字用逗号、顿号或空格分隔，如：伟,强"
        value="{{avoidChars}}"
        bindinput="onAvoidInput"
      />
      <view class="avoid-tip">避讳字会在候选与组合阶段被硬剔除，例如家族长辈用字。</view>
    </view>
  </view>

  <!-- 主行动 -->
  <view class="foot">
    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}">
      {{tab === 'prenatal' ? '查看孕期参考' : '生成名字'}}
    </button>
    <view class="foot-note" wx:if="{{tab === 'prenatal'}}">预产期给的是范围参考，不用挑字</view>
    <view class="foot-note" wx:elif="{{path === 'chars'}}">已选 {{pickedCount}} 个字，名字里会含其中之一</view>
    <view class="foot-note" wx:elif="{{path === 'sources'}}">已选 {{sourceCount}} 类典籍</view>
    <view class="foot-note" wx:else>什么都不选也行，会按韵味给出各方向的名字</view>
  </view>
</view>
