/* 起名第二步 · 定偏好（山水泼墨） */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.head {
  padding: 40rpx 40rpx 20rpx;
}

.head-title {
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
}

.head-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* 点题：每个名字都有内涵 */
.intro {
  margin: 0 40rpx;
  padding: 20rpx 26rpx;
  border-left: 4rpx solid var(--cinnabar);
  background: var(--card);
  font-family: var(--serif);
  font-size: 24rpx;
  letter-spacing: 3rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* ── 分区 ── */
.block {
  margin: 32rpx 40rpx 0;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line);
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.block-title {
  font-family: var(--serif);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.block-tail {
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.block-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── 期许分组（7 个方向，每块一句人话 + 标签）── */
.group {
  margin-top: 26rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.group-title {
  font-family: var(--serif);
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  color: var(--ink);
}

.group-sub {
  margin-left: 16rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

/* ── 偏好标签（气质 / 期待 / 意象 / 典籍）──
   选中用墨色实底（与基础资料页的 chip 同语言），不用朱砂 ——
   朱砂留给「真正被选进名字」的字，避免一屏红点看不出轻重。 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 28rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  line-height: 1.3;
  color: var(--ink-2);
  background: transparent;
}

.tag.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 避讳字 ── */
.avoid {
  margin: 32rpx 40rpx 0;
  border-top: 1rpx solid var(--line);
}

.avoid-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.avoid-toggle-text {
  font-size: 27rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.avoid-toggle-tail {
  font-size: 24rpx;
  color: var(--ink-3);
}

.avoid-body {
  padding-bottom: 28rpx;
}

.avoid-input {
  font-size: 30rpx;
  color: var(--ink);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.avoid-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── 主行动 ── */
.foot {
  padding: 56rpx 40rpx 0;
}

.foot-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* 批次用完：把转发入口直接放在主行动下面，别让用户点进去再被拦在结果页 */
.quota-row {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--paper-deep);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  text-align: center;
}

.quota-row-text {
  display: block;
  font-size: 24rpx;
  color: var(--ochre);
  letter-spacing: 1rpx;
}

.quota-row-btn {
  margin-top: 14rpx;
  padding: 16rpx 0;
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.5;
  color: var(--ink);
  text-align: center;
}
