.progress-wrap {
  margin-bottom: 24rpx;
}

.progress-track {
  height: 10rpx;
  background: #E2DED5;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1F1F1F, #5E7A73);
  border-radius: 10rpx;
  transition: width 0.25s ease;
}

.step-indicator {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.step-current {
  font-size: 26rpx;
  color: #5E7A73;
  font-weight: 600;
}

.step-title {
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: 600;
}

.step-hint {
  font-size: 24rpx;
  color: #9C9A92;
  margin-bottom: 20rpx;
}

/* 风格卡片 */
.style-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.style-card {
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.style-card.active {
  border-color: #1F1F1F;
  background: #F0EDE4;
}

.style-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.style-feeling {
  font-size: 24rpx;
  color: #5E7A73;
  margin-top: 6rpx;
}

.style-examples {
  font-size: 26rpx;
  color: #5C5C5C;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 寓意卡片 */
.meaning-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meaning-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.meaning-card.active {
  border-color: #1F1F1F;
  background: #F0EDE4;
}

.meaning-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.meaning-feeling {
  font-size: 22rpx;
  color: #5E7A73;
  margin-top: 6rpx;
}

.meaning-examples {
  font-size: 24rpx;
  color: #5C5C5C;
  margin-top: 10rpx;
}

/* 避讳字 */
.avoid-card {
  padding-top: 30rpx;
}

.avoid-input {
  border: 1rpx solid #D8D2C6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #F4F0E7;
}

.avoid-tip {
  font-size: 22rpx;
  color: #B2B0A8;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 确认汇总 */
.summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 12rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #E2DED5;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #9C9A92;
}

.summary-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.summary-edit {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #5E7A73;
}

.tap-row:active {
  background: #F4F0E7;
}

/* 底部导航 */
.wizard-nav {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.nav-btn {
  flex: 1;
}

/* Step5 精选用字 */
.char-count {
  font-size: 24rpx;
  color: #9C9A92;
  margin-bottom: 16rpx;
}

.char-count-num {
  color: #5E7A73;
  font-weight: 600;
}

.char-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9C9A92;
}

.char-group {
  margin-bottom: 24rpx;
}

.char-group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.char-group-wx {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.char-group-flag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #E8F5E9;
  color: #4CAF50;
}

.char-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.char-chip {
  width: calc(25% - 12rpx);
  box-sizing: border-box;
  background: #FCFAF5;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.char-chip.active {
  border-color: #1F1F1F;
  background: #F0EDE4;
}

.char-chip-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #1F1F1F;
  line-height: 1.2;
}

.char-chip-pinyin {
  font-size: 20rpx;
  color: #5E7A73;
  margin-top: 4rpx;
}

/* 起名方式（寓意优先 / 命格优先） */
.mode-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mode-card {
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.mode-card.active {
  border-color: #1F1F1F;
  background: #F0EDE4;
}

.mode-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.mode-desc {
  font-size: 24rpx;
  color: #5C5C5C;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* 命格简析卡片 */
.bazi-card {
  background: #F4F0E7;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E2DED5;
}

.bazi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.bazi-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.bazi-strength {
  font-size: 22rpx;
  color: #5E7A73;
  background: #E8F0ED;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.bazi-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
}

.bazi-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9C9A92;
}

.bazi-value {
  font-size: 26rpx;
  color: #333;
}

.bazi-suggestion {
  font-size: 24rpx;
  color: #5C5C5C;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 意境来源 */
.source-count {
  font-size: 24rpx;
  color: #9C9A92;
  margin-bottom: 16rpx;
}

.source-count-num {
  color: #5E7A73;
  font-weight: 600;
}

.source-card {
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.source-card.active {
  border-color: #1F1F1F;
  background: #F0EDE4;
}

.source-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.source-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.source-author {
  font-size: 22rpx;
  color: #9C9A92;
}

.source-text {
  font-size: 28rpx;
  color: #333;
  margin-top: 14rpx;
  line-height: 1.7;
}

.source-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.source-flag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #E8F5E9;
  color: #4CAF50;
}

.flag-ji {
  background: #FBE9E7;
  color: #E57373;
}

.flag-neutral {
  background: #ECEAE3;
  color: #8A887F;
}

.source-reason {
  font-size: 22rpx;
  color: #9C9A92;
  line-height: 1.5;
}

/* 来源内选字 */
.source-line {
  font-size: 24rpx;
  color: #9C9A92;
  margin: -4rpx 0 14rpx;
  line-height: 1.6;
}

.char-chip {
  position: relative;
}

.char-chip-tag {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #4CAF50;
  font-weight: 600;
}

.char-chip-tag-ji {
  color: #E57373;
}

.empty-hint {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9C9A92;
}
