/* 起名第二步 · 挑一种感觉（山水泼墨） */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 窄幅泼墨页头 ── */
.band {
  width: 100%;
  overflow: hidden;
}

.band-img {
  width: 100%;
  display: block;
}

.head {
  padding: 40rpx 40rpx 36rpx;
}

.head-title {
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
}

.head-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* ── 感觉卡 ── */
.feel-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 40rpx;
}

.feel-card {
  width: 48.5%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 34rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}

/* 朱砂只用于「选中」这一处语义 */
.feel-card.active {
  border-color: var(--cinnabar);
  background: var(--cinnabar-bg);
}

.feel-card:active {
  background: var(--paper-deep);
}

.feel-card.active:active {
  background: var(--cinnabar-bg);
}

.feel-title {
  font-family: var(--serif);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  color: var(--ink);
  line-height: 1.3;
}

.feel-card.active .feel-title {
  color: var(--cinnabar);
}

.feel-imagery {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

/* ── 避讳字 ── */
.avoid {
  margin: 32rpx 40rpx 0;
  border-top: 1rpx solid var(--line);
}

.avoid-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.avoid-toggle-text {
  font-size: 27rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.avoid-toggle-tail {
  font-size: 24rpx;
  color: var(--ink-3);
}

.avoid-body {
  padding-bottom: 28rpx;
}

.avoid-input {
  font-size: 30rpx;
  color: var(--ink);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.avoid-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── 主行动 ── */
.foot {
  padding: 56rpx 40rpx 0;
}

.foot-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}
