<view class="page">
  <view class="head">
    <view class="head-title">{{title}}</view>
    <view class="head-meta">{{sub}}</view>
  </view>

  <!-- 网名昵称：细分 tab -->
  <view class="sub-tabs" wx:if="{{mode === 'netname'}}">
    <view
      wx:for="{{subTabs}}"
      wx:key="code"
      class="sub-tab {{subKind === item.code ? 'active' : ''}}"
      bindtap="onSubTabTap"
      data-kind="{{item.code}}"
    >{{item.name}}</view>
  </view>

  <view class="form-card">
    <!-- 宠物种类 -->
    <view class="form-item" wx:if="{{mode === 'pet'}}">
      <text class="form-label">毛孩子种类</text>
      <view class="chip-row">
        <view
          wx:for="{{petTypes}}"
          wx:key="code"
          class="chip {{petType === item.code ? 'active' : ''}}"
          bindtap="onPetTypeTap"
          data-type="{{item.code}}"
        >{{item.name}}</view>
      </view>
    </view>

    <!-- 行业：14 项，用可点标签而不是原生 picker（预览里 picker 点不开） -->
    <view class="form-item form-item-col" wx:if="{{mode === 'business'}}">
      <text class="form-label">行业</text>
      <view class="chip-row-wrap">
        <view
          wx:for="{{industries}}"
          wx:key="code"
          class="chip {{industryIndex === index ? 'active' : ''}}"
          bindtap="onIndustryTap"
          data-index="{{index}}"
        >{{item.name}}</view>
      </view>
    </view>

    <!-- 平台名称：目标平台 -->
    <view class="form-item form-item-col" wx:if="{{mode === 'netname' && subKind === 'platform'}}">
      <text class="form-label">目标平台</text>
      <view class="chip-row-wrap">
        <view
          wx:for="{{platformTypes}}"
          wx:key="code"
          class="chip {{platformType === item.code ? 'active' : ''}}"
          bindtap="onPlatformTypeTap"
          data-code="{{item.code}}"
        >{{item.name}}</view>
      </view>
    </view>

    <!-- 游戏昵称：游戏类型 -->
    <view class="form-item form-item-col" wx:if="{{mode === 'netname' && subKind === 'game'}}">
      <text class="form-label">游戏类型</text>
      <view class="chip-row-wrap">
        <view
          wx:for="{{gameTypes}}"
          wx:key="code"
          class="chip {{gameType === item.code ? 'active' : ''}}"
          bindtap="onGameTypeTap"
          data-code="{{item.code}}"
        >{{item.name}}</view>
      </view>
    </view>

    <!-- 虚拟角色：性别 + 小说类型 + 性格特征 + 自定义描述 -->
    <block wx:if="{{mode === 'netname' && subKind === 'role'}}">
      <view class="form-item form-item-col">
        <text class="form-label">角色性别</text>
        <view class="chip-row-wrap">
          <view
            wx:for="{{roleGenders}}"
            wx:key="code"
            class="chip {{roleGender === item.code ? 'active' : ''}}"
            bindtap="onRoleGenderTap"
            data-code="{{item.code}}"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="form-item form-item-col">
        <text class="form-label">小说类型</text>
        <view class="chip-row-wrap">
          <view
            wx:for="{{genres}}"
            wx:key="code"
            class="chip {{genre === item.code ? 'active' : ''}}"
            bindtap="onGenreTap"
            data-code="{{item.code}}"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="form-item form-item-col">
        <text class="form-label">性格特征</text>
        <view class="chip-row-wrap">
          <view
            wx:for="{{traits}}"
            wx:key="code"
            class="chip {{trait === item.code ? 'active' : ''}}"
            bindtap="onTraitTap"
            data-code="{{item.code}}"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="form-item form-item-col">
        <text class="form-label">自定义描述</text>
        <textarea
          class="form-textarea"
          placeholder="比如：修仙界落难女剑仙，身负寒毒，清冷孤傲"
          placeholder-class="ph"
          value="{{customDesc}}"
          bindinput="onCustomDescInput"
          maxlength="300"
          auto-height
        />
        <!-- 广告位未开通时不能先说「看广告解锁」，那是给不出的承诺：
             这里如实说清楚生成会走本地词库、描述不参与 -->
        <text class="form-hint" wx:if="{{isLLMPath && canWatchAd}}">已填描述，生成将走「看广告解锁 AI」</text>
        <text class="form-hint form-hint-warn" wx:if="{{isLLMPath && !canWatchAd}}">
          AI 生成需要激励视频广告位，当前未开通。生成会用本地词库，自定义描述这次不参与。
        </text>
      </view>
    </block>

    <!-- 关键词（非角色分支） -->
    <view class="form-item" wx:if="{{!(mode === 'netname' && subKind === 'role')}}">
      <text class="form-label">{{kwLabel}}</text>
      <input
        class="form-input"
        placeholder="{{placeholder}}"
        placeholder-class="ph"
        value="{{keywords}}"
        bindinput="onKeywordsInput"
        confirm-type="done"
        bindconfirm="onGenerate"
      />
    </view>
  </view>

  <view class="foot">
    <button class="btn-primary" bindtap="onGenerate" loading="{{loading}}">
      {{loading ? '正在生成' : (isLLMPath && canWatchAd ? '看广告解锁 AI 生成' : (generated ? '再生成一批' : '生成名字'))}}
    </button>
  </view>

  <!-- 结果 -->
  <view class="results" wx:if="{{generated}}">
    <!-- 降级说明常驻在结果上方，不用 toast：一旦一闪而过，用户会以为描述真的生效了 -->
    <view class="fallback-note" wx:if="{{fallbackNote}}">{{fallbackNote}}</view>
    <view class="results-title">{{names.length}} 个名字{{llmSource === 'llm' ? ' · AI 生成' : ''}} · 点击即可复制</view>
    <view
      class="name-card"
      wx:for="{{names}}"
      wx:key="name"
      hover-class="name-press"
      hover-stay-time="60"
      bindtap="onNameTap"
      data-name="{{item.name}}"
    >
      <view class="name-row">
        <text class="name-text">{{item.name}}</text>
        <text class="name-tag">{{item.tag}}</text>
      </view>
      <text class="name-reason">{{item.reason}}</text>
    </view>
    <view class="empty-hint" wx:if="{{!names.length}}">没有生成到名字，换个输入试试</view>
  </view>
</view>
