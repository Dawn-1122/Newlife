/* 创意起名页 · 山水泼墨（网名昵称 / 宠物 / 商业） */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.head {
  padding: 40rpx 40rpx 8rpx;
}

.head-title {
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
}

.head-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── 网名昵称细分 tab ── */
.sub-tabs {
  display: flex;
  margin: 28rpx 40rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.sub-tab.active {
  color: var(--ink);
  border-bottom-color: var(--cinnabar);
}

/* ── 表单 ── */
.form-card {
  padding: 8rpx 40rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  width: 200rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.ph {
  color: var(--ink-3);
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.chip-row {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

.chip-row .chip + .chip {
  margin-left: 14rpx;
}

.chip {
  padding: 14rpx 30rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  color: var(--ink-2);
  background: transparent;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 虚拟角色分支：纵向表单 + 可换行标签 ── */
.form-item-col {
  flex-direction: column;
  align-items: flex-start;
}

.form-item-col .form-label {
  width: auto;
  margin-bottom: 16rpx;
}

.chip-row-wrap {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}

.chip-row-wrap .chip {
  margin: 0 14rpx 14rpx 0;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
}

.form-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ochre);
}

/* 降级类的说明要更醒目一点：它改变的是「你将拿到什么」，不只是补充信息 */
.form-hint-warn {
  display: block;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  line-height: 1.7;
  background: var(--paper-deep);
  border-radius: var(--r-sm);
}

/* 结果上方的降级说明：常驻，不随 toast 消失 */
.fallback-note {
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: var(--ochre);
  background: var(--paper-deep);
  border-left: 5rpx solid var(--ochre);
  border-radius: var(--r-sm);
}

/* ── 主行动 ── */
.foot {
  padding: 48rpx 40rpx 0;
}

/* ── 结果 ── */
.results {
  padding: 40rpx 40rpx 0;
}

.results-title {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  margin-bottom: 24rpx;
}

.name-card {
  padding: 30rpx 30rpx;
  margin-bottom: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: var(--r-md);
}

.name-press {
  border-color: var(--cinnabar);
  background: var(--cinnabar-bg);
}

.name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.name-text {
  font-family: var(--serif);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.name-tag {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.name-reason {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}
