/* 创意起名页 · 山水泼墨（网名昵称 / 宠物 / 商业） */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 窄幅泼墨页头 ── */
.band {
  width: 100%;
  overflow: hidden;
}

.band-img {
  width: 100%;
  display: block;
}

.head {
  padding: 40rpx 40rpx 8rpx;
}

.head-title {
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
}

.head-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── 网名昵称细分 tab ── */
.sub-tabs {
  display: flex;
  margin: 28rpx 40rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.sub-tab.active {
  color: var(--ink);
  border-bottom-color: var(--cinnabar);
}

/* ── 表单 ── */
.form-card {
  padding: 8rpx 40rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  width: 200rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.ph {
  color: var(--ink-3);
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.chip-row {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

.chip-row .chip + .chip {
  margin-left: 14rpx;
}

.chip {
  padding: 14rpx 30rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  color: var(--ink-2);
  background: transparent;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 主行动 ── */
.foot {
  padding: 48rpx 40rpx 0;
}

/* ── 结果 ── */
.results {
  padding: 40rpx 40rpx 0;
}

.results-title {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  margin-bottom: 24rpx;
}

.name-card {
  padding: 30rpx 30rpx;
  margin-bottom: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: var(--r-md);
}

.name-press {
  border-color: var(--cinnabar);
  background: var(--cinnabar-bg);
}

.name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.name-text {
  font-family: var(--serif);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.name-tag {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.name-reason {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}
