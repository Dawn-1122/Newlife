<wxs module="m">
  var wuxingMap = { '金': 'wx-jin', '木': 'wx-mu', '水': 'wx-shui', '火': 'wx-huo', '土': 'wx-tu' }
  module.exports = {
    wx: function(v) { return wuxingMap[v] || '' }
  }
</wxs>
<view class="container">
  <!-- 确定性的历法信息：预产期当天就是这些，无需推算 -->
  <view class="card">
    <view class="section-title">预产期范围</view>
    <view class="range-row">
      <text class="range-label">预产期</text>
      <text class="range-value">{{result.due_date}}</text>
    </view>
    <view class="range-row">
      <text class="range-label">浮动范围</text>
      <text class="range-value">{{result.range.start}} ~ {{result.range.end}}</text>
    </view>
    <view class="certain-row">
      <view class="certain-item">
        <text class="certain-label">生肖</text>
        <text class="certain-value">{{result.certain.shengxiao}}</text>
      </view>
      <view class="certain-item">
        <text class="certain-label">月柱</text>
        <text class="certain-value">{{result.certain.month_ganzhi}}</text>
      </view>
      <view class="certain-item">
        <text class="certain-label">月柱五行</text>
        <text class="certain-value wuxing-text {{m.wx(result.certain.month_wuxing)}}">{{result.certain.month_wuxing}}</text>
      </view>
    </view>
  </view>

  <!-- 分布统计：只数天数，不做任何判断 -->
  <view class="card">
    <view class="section-title">日柱天干五行分布</view>
    <view class="card-desc">这一范围内共 {{totalDays}} 天。每天的日柱天干各属一种五行，下面是各五行出现的天数占比。</view>
    <view class="bar-row" wx:for="{{dayMasterDist}}" wx:key="name">
      <text class="bar-name wuxing-text {{m.wx(item.name)}}">{{item.name}}</text>
      <view class="bar-track">
        <view class="bar-fill {{m.wx(item.name)}}" style="width: {{item.percent}}%;"></view>
      </view>
      <text class="bar-percent">{{item.percent}}%</text>
    </view>
  </view>

  <view class="foot-tip">出生后知道确切日期，再按实际日期起名。</view>

  <view class="adjust-bar" bindtap="onAdjustPref">
    <text class="adjust-text">调整预产期</text>
    <text class="adjust-more">›</text>
  </view>

  <button class="btn-primary" bindtap="onBackHome">返回首页</button>
</view>
