.adjust-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 6rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.adjust-text {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.adjust-more {
  font-size: 30rpx;
  color: var(--ink-2);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--ink-2);
}

.range-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.range-label {
  font-size: 26rpx;
  color: var(--ink-3);
}

.range-value {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.certain-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

.certain-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.certain-label {
  font-size: 24rpx;
  color: var(--ink-3);
}

.certain-value {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 6rpx;
}

/* 五行颜色 */
.wuxing-text.wx-jin { color: var(--wx-jin); }
.wuxing-text.wx-mu { color: var(--wx-mu); }
.wuxing-text.wx-shui { color: var(--wx-shui); }
.wuxing-text.wx-huo { color: var(--wx-huo); }
.wuxing-text.wx-tu { color: var(--wx-tu); }

/* 概率柱状条 */
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-name {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: var(--line);
  border-radius: 4rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
}

.bar-fill.wx-jin { background: var(--wx-jin); }
.bar-fill.wx-mu { background: var(--wx-mu); }
.bar-fill.wx-shui { background: var(--wx-shui); }
.bar-fill.wx-huo { background: var(--wx-huo); }
.bar-fill.wx-tu { background: var(--wx-tu); }

.bar-percent {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

/* 建议 */
.stable-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stable-label {
  font-size: 26rpx;
  color: var(--ink-3);
}

.stable-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.safe-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}

.safe-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.safe-item {
  width: 30%;
  background: var(--paper);
  border-radius: 4rpx;
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.safe-char {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
}

.safe-meta {
  font-size: 20rpx;
  color: var(--ink-2);
}

.safe-meaning {
  font-size: 22rpx;
  color: var(--ink-2);
  text-align: center;
}

.note {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--paper-deep);
  border-radius: 4rpx;
  font-size: 24rpx;
  color: var(--ochre);
  line-height: 1.7;
}

.btn-primary {
  margin-top: 10rpx;
}
