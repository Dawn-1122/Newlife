.adjust-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 6rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.adjust-text {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
}

.adjust-more {
  font-size: 30rpx;
  color: #4A4F55;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #16181A;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A4F55;
}

.range-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.range-label {
  font-size: 26rpx;
  color: #8A9099;
}

.range-value {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
}

.certain-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #E4E2DD;
}

.certain-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.certain-label {
  font-size: 24rpx;
  color: #8A9099;
}

.certain-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #16181A;
  margin-top: 6rpx;
}

/* 五行颜色 */
.wuxing-text.wx-jin { color: #8D7B4F; }
.wuxing-text.wx-mu { color: #4E6B54; }
.wuxing-text.wx-shui { color: #3E5A73; }
.wuxing-text.wx-huo { color: #A6321F; }
.wuxing-text.wx-tu { color: #7A6248; }

/* 概率柱状条 */
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-name {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: #E4E2DD;
  border-radius: 4rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
}

.bar-fill.wx-jin { background: #8D7B4F; }
.bar-fill.wx-mu { background: #4E6B54; }
.bar-fill.wx-shui { background: #3E5A73; }
.bar-fill.wx-huo { background: #A6321F; }
.bar-fill.wx-tu { background: #7A6248; }

.bar-percent {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8A9099;
  flex-shrink: 0;
}

/* 建议 */
.stable-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stable-label {
  font-size: 26rpx;
  color: #8A9099;
}

.stable-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #16181A;
}

.safe-label {
  display: block;
  font-size: 26rpx;
  color: #8A9099;
  margin-bottom: 12rpx;
}

.safe-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.safe-item {
  width: 30%;
  background: #F7F6F3;
  border-radius: 4rpx;
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.safe-char {
  font-size: 40rpx;
  font-weight: 500;
  color: #16181A;
}

.safe-meta {
  font-size: 20rpx;
  color: #4A4F55;
}

.safe-meaning {
  font-size: 22rpx;
  color: #4A4F55;
  text-align: center;
}

.note {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #EFEDE8;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #8D7B4F;
  line-height: 1.7;
}

.btn-primary {
  margin-top: 10rpx;
}
