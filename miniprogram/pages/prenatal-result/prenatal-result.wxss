.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #8B4513;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #C19A6B;
}

.range-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.range-label {
  font-size: 26rpx;
  color: #999;
}

.range-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.certain-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #f0ede8;
}

.certain-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.certain-label {
  font-size: 24rpx;
  color: #999;
}

.certain-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #8B4513;
  margin-top: 6rpx;
}

/* 五行颜色 */
.wuxing-text.wx-jin { color: #C4A21E; }
.wuxing-text.wx-mu { color: #4CAF50; }
.wuxing-text.wx-shui { color: #2196F3; }
.wuxing-text.wx-huo { color: #FF5722; }
.wuxing-text.wx-tu { color: #8D6E63; }

/* 概率柱状条 */
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-name {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: #f0ede8;
  border-radius: 12rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
}

.bar-fill.wx-jin { background: #C4A21E; }
.bar-fill.wx-mu { background: #4CAF50; }
.bar-fill.wx-shui { background: #2196F3; }
.bar-fill.wx-huo { background: #FF5722; }
.bar-fill.wx-tu { background: #8D6E63; }

.bar-percent {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

/* 建议 */
.stable-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stable-label {
  font-size: 26rpx;
  color: #999;
}

.stable-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #8B4513;
}

.safe-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.safe-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.safe-item {
  width: 30%;
  background: #faf8f5;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.safe-char {
  font-size: 40rpx;
  font-weight: 600;
  color: #8B4513;
}

.safe-meta {
  font-size: 20rpx;
  color: #C19A6B;
}

.safe-meaning {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

.note {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.7;
}

.btn-primary {
  margin-top: 10rpx;
}
