<view class="page">
  <!-- 页标题交给导航栏（「更多功能」），页内不再重复一遍 -->
  <!-- 分组列表 -->
  <view class="group" wx:for="{{groups}}" wx:key="title" wx:for-item="group">
    <view class="group-title">{{group.title}}</view>

    <view
      class="row {{item.available ? '' : 'disabled'}}"
      wx:for="{{group.items}}"
      wx:key="key"
      bindtap="onRowTap"
      data-url="{{item.url}}"
      data-available="{{item.available}}"
    >
      <text class="row-name">{{item.name}}</text>
      <text class="row-tail" wx:if="{{item.available}}">›</text>
      <text class="row-tail row-badge" wx:else>即将上线</text>
    </view>
  </view>
</view>
