.header {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F1F1F;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #5E7A73;
  margin-top: 8rpx;
}

.tab-bar {
  display: flex;
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #5C5C5C;
  border-radius: 12rpx;
}

.tab.active {
  background: #1F1F1F;
  color: #fff;
  font-weight: 500;
}

.form-card {
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E2DED5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.column {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #5C5C5C;
  width: 160rpx;
  flex-shrink: 0;
}

.form-item.column .form-label {
  width: auto;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  flex: 1;
  justify-content: flex-end;
}

.chip-row.wrap {
  flex-wrap: wrap;
  justify-content: flex-start;
}

.chip {
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  background: #ECE8DE;
  color: #5C5C5C;
  font-size: 26rpx;
}

.chip.active {
  background: #1F1F1F;
  color: #fff;
}

.footer-note {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.footer-note text {
  font-size: 22rpx;
  color: #B2B0A8;
}
