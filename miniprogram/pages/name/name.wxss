/* 起名第一步 · 填资料（山水泼墨） */

/* 日期弹层与下拉面板样式与 analyze 页共用，避免两处各写一份走样 */
@import "../../styles/date-sheet.wxss";
@import "../../styles/select-panel.wxss";

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 窄幅泼墨页头 ── */
.band {
  width: 100%;
  overflow: hidden;
}

.band-img {
  width: 100%;
  display: block;
}

.head {
  padding: 40rpx 40rpx 28rpx;
}

.head-title {
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
}

/* ── 表单 ── */
.form-card {
  padding: 8rpx 40rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

/* 纵向布局：标签在上，选项在下（选项一多就不能挤在一行里） */
.form-item-col {
  display: block;
}

.form-label {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  width: 170rpx;
  flex-shrink: 0;
}

.form-label-inline {
  width: auto;
}

.form-label-block {
  display: block;
  width: auto;
  margin-bottom: 16rpx;
}

/* 开关那一行：左边「标题 + 一句解释」上下排，右边开关 */
.form-item-switch {
  align-items: center;
}

.switch-label {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.form-hint {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.hint-block {
  display: block;
  margin-top: 14rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.picker-value.placeholder {
  color: var(--line-strong);
}

/* 可点击字段右侧的小箭头，暗示"这里能点开" */
.field-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: var(--line-strong);
  line-height: 1;
}

/* ── 选项 ── */
.chip-row {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

.chip-row.start {
  justify-content: flex-start;
}

.chip-row .chip + .chip {
  margin-left: 14rpx;
}

.chip-row.wrap {
  flex-wrap: wrap;
  justify-content: flex-start;
}

/* wrap 布局下换行间距用 margin 而非 gap，兼容旧 WebView */
.chip-row.wrap .chip {
  margin: 0 14rpx 14rpx 0;
}

.chip {
  padding: 14rpx 30rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  color: var(--ink-2);
  background: transparent;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 时辰下拉见 styles/select-panel.wxss ── */

/* ── 主行动 ── */
.foot {
  padding: 56rpx 40rpx 0;
}
