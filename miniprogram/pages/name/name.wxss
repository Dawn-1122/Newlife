/* 起名第一步 · 填资料（山水泼墨） */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 窄幅泼墨页头 ── */
.band {
  width: 100%;
  overflow: hidden;
}

.band-img {
  width: 100%;
  display: block;
}

.head {
  padding: 40rpx 40rpx 28rpx;
}

.head-title {
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
}

/* ── 已出生 / 未出生 ── */
.tab-bar {
  display: flex;
  margin: 0 40rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.tab.active {
  color: var(--ink);
  border-bottom-color: var(--cinnabar);
}

/* ── 表单 ── */
.form-card {
  padding: 8rpx 40rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
  width: 170rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}

.chip-row {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

.chip-row .chip + .chip {
  margin-left: 14rpx;
}

.chip-row.wrap {
  flex-wrap: wrap;
  justify-content: flex-start;
}

/* wrap 布局下换行间距用 margin 而非 gap，兼容旧 WebView */
.chip-row.wrap .chip {
  margin: 0 14rpx 14rpx 0;
}

.chip {
  padding: 14rpx 30rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  color: var(--ink-2);
  background: transparent;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 主行动 ── */
.foot {
  padding: 56rpx 40rpx 0;
}
