<view class="page">
  <!-- 页标题交给导航栏（「名字本」），页内不再重复一遍 -->
  <!-- 分段：起名记录 / 收藏 -->
  <view class="seg-wrap">
    <view class="seg">
      <view
        class="seg-item {{tab === 'records' ? 'on' : ''}}"
        data-tab="records"
        bindtap="onTabTap"
      >起名记录</view>
      <view
        class="seg-item {{tab === 'favs' ? 'on' : ''}}"
        data-tab="favs"
        bindtap="onTabTap"
      >收藏</view>
    </view>
  </view>

  <!-- ── 起名记录 ── -->
  <view class="list" wx:if="{{tab === 'records'}}">
    <view
      class="rec"
      wx:for="{{records}}"
      wx:key="id"
      bindtap="onRecordTap"
      data-id="{{item.id}}"
    >
      <view class="rec-head">
        <text class="rec-title">{{item.title}}</text>
        <text class="rec-kind">{{item.kindLabel}}</text>
      </view>
      <view class="rec-sub">{{item.subtitle}}</view>

      <view class="chips" wx:if="{{item.chips.length}}">
        <text class="chip" wx:for="{{item.chips}}" wx:for-item="c" wx:key="text">{{c.text}}</text>
      </view>

      <view class="rec-foot">
        <text class="rec-time">{{item.createdText}}</text>
        <text class="rec-del" catchtap="onRecordDelete" data-id="{{item.id}}">删除</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!records.length}}">
      <text class="empty-title">还没有起名记录</text>
      <text class="empty-note">起的每一批名字都会自动收进这里，方便回头再看</text>
    </view>
  </view>

  <!-- ── 收藏 ── -->
  <view class="list" wx:else>
    <view
      class="fav"
      wx:for="{{favs}}"
      wx:key="id"
      bindtap="onFavTap"
      data-id="{{item.id}}"
    >
      <view class="fav-head">
        <text class="fav-name">{{item.full_name}}</text>
        <view class="score-badge {{item.tier}}"><text class="score-label">推荐值</text><text class="score-num">{{item.recommend}}</text></view>
      </view>

      <view class="fav-pinyin">{{item.pinyinText}}</view>
      <view class="fav-poetry" wx:if="{{item.source}}">「{{item.source}}·{{item.title}}」</view>

      <view class="rec-foot">
        <text class="rec-time">收藏于 {{item.savedText}}</text>
        <text class="rec-del" catchtap="onFavDelete" data-id="{{item.id}}">取消收藏</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!favs.length}}">
      <text class="empty-title">还没有收藏名字</text>
      <text class="empty-note">在结果页或名字详情页点「收藏」，中意的名字就留在这里</text>
    </view>
  </view>

  <!-- 底部：清空（有内容才出现） -->
  <view class="foot" wx:if="{{tab === 'records' ? records.length : favs.length}}">
    <button class="btn-secondary" bindtap="onClearTap">{{tab === 'records' ? '清空起名记录' : '清空收藏'}}</button>
  </view>
</view>
