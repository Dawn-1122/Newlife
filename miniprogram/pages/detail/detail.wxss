.name-display {
  text-align: center;
  padding: 50rpx 30rpx;
}

.name-main {
  font-size: 64rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 12rpx;
}

.name-pinyin {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--ink);
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--ink-2);
}

/* 用字解析 */
.char-item {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.char-item:last-child {
  border-bottom: none;
}

.char-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
}

.char-text {
  font-size: 48rpx;
  font-weight: 500;
  color: var(--ink);
}

.char-pinyin {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
}

.char-detail {
  flex: 1;
}

.char-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--paper-deep);
  color: var(--ink-2);
}

.wuxing-tag.wx-jin { background: var(--paper-deep); color: var(--wx-jin); }
.wuxing-tag.wx-mu { background: var(--paper-deep); color: var(--wx-mu); }
.wuxing-tag.wx-shui { background: var(--paper-deep); color: var(--wx-shui); }
.wuxing-tag.wx-huo { background: var(--cinnabar-bg); color: var(--wx-huo); }
.wuxing-tag.wx-tu { background: var(--paper-deep); color: var(--wx-tu); }

.char-meaning {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

/* 说文解字 */
.char-shuowen {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  background: var(--paper);
  border-radius: 4rpx;
}

.shuowen-label {
  display: block;
  font-size: 22rpx;
  color: var(--ink-2);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.shuowen-text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* 字源释义 */
.char-detail-text {
  margin-top: 10rpx;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 6rpx;
}

.detail-text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* 诗词 */
.poetry-block {
  padding: 20rpx;
  background: var(--paper);
  border-radius: 4rpx;
}

.poetry-header {
  margin-bottom: 12rpx;
}

.poetry-source {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  display: block;
}

.poetry-author {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  display: block;
}

.poetry-text {
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1.8;
  font-style: italic;
}

/* 音律 */
.phonetics-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.phon-row {
  display: flex;
  justify-content: space-between;
}

.phon-label {
  font-size: 28rpx;
  color: var(--ink-2);
}

.phon-value {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.phon-desc {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* 五格 */
.wuge-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.wuge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuge-name {
  font-size: 24rpx;
  color: var(--ink-3);
}

.wuge-num {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 4rpx;
}

/* 天格由姓氏笔画决定，与名字无关，故只标一个灰字说明，不判吉凶 */
.wuge-note {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: var(--ink-3);
}

.wuge-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

/* 寓意 */
.meaning-text {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

.actions {
  padding: 20rpx 0 60rpx;
}

/* 收藏在复制下方：两个 button 默认块级堆叠，给上面那个留出间距 */
.actions .btn-secondary {
  margin-bottom: 20rpx;
}

/* 深度寓意（多层余味） */
.deep-block {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.deep-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.deep-loading {
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 20rpx 0;
}

.layer-item {
  padding: 16rpx 0;
}

.layer-item + .layer-item {
  border-top: 1rpx dashed var(--line);
}

.layer-level {
  display: inline-block;
  font-size: 22rpx;
  color: var(--ink-2);
  font-weight: 500;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  background: var(--paper-deep);
  margin-bottom: 8rpx;
}

.layer-text {
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

.meaning-source {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: right;
}

/* 分享解锁遮罩 */
.unlock-mask {
  margin-top: 28rpx;
  padding: 40rpx 30rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: 6rpx;
  background: var(--card);
  text-align: center;
}

.unlock-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.unlock-desc {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
  margin: 16rpx 0 28rpx;
}

.unlock-btn {
  display: inline-block;
  width: 60%;
  margin: 0 auto;
}

/* 语境取义（同一字在不同诗句中含义不同） */
.char-senses {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.senses-label {
  font-size: 22rpx;
  color: var(--ink-3);
}

.sense-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.sense-chip {
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--paper-deep);
  border-radius: 3rpx;
  padding: 4rpx 14rpx;
}

.ctx-senses {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border-radius: 4rpx;
}

.ctx-title {
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.ctx-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.ctx-char {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
}

.ctx-arrow {
  font-size: 22rpx;
  color: var(--ink-3);
}

.ctx-words {
  font-size: 26rpx;
  color: var(--ink-2);
}

.ctx-general {
  color: var(--ink-3);
}

.ctx-mark {
  font-size: 22rpx;
  color: var(--ink-3);
  border: 1rpx solid var(--line-strong);
  border-radius: 6rpx;
  padding: 0 8rpx;
}

.ctx-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
}
