.name-display {
  text-align: center;
  padding: 50rpx 30rpx;
}

.name-main {
  font-size: 64rpx;
  font-weight: 700;
  color: #1F1F1F;
  letter-spacing: 12rpx;
}

.name-pinyin {
  font-size: 28rpx;
  color: #5E7A73;
  margin-top: 12rpx;
}

.name-score {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
}

.score-label {
  font-size: 26rpx;
  color: #9C9A92;
}

.score-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #1F1F1F;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #5E7A73;
}

/* 用字解析 */
.char-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E2DED5;
}

.char-item:last-child {
  border-bottom: none;
}

.char-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
}

.char-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
}

.char-pinyin {
  font-size: 22rpx;
  color: #5E7A73;
  margin-top: 4rpx;
}

.char-detail {
  flex: 1;
}

.char-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #ECE8DE;
  color: #5C5C5C;
}

.wuxing-tag.wx-jin { background: #FFF8E1; color: #C4A21E; }
.wuxing-tag.wx-mu { background: #E8F5E9; color: #4CAF50; }
.wuxing-tag.wx-shui { background: #E3F2FD; color: #2196F3; }
.wuxing-tag.wx-huo { background: #FBE9E7; color: #FF5722; }
.wuxing-tag.wx-tu { background: #EFEBE9; color: #8D6E63; }

.char-meaning {
  font-size: 26rpx;
  color: #5C5C5C;
  line-height: 1.5;
}

/* 说文解字 */
.char-shuowen {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #F4F0E7;
  border-radius: 10rpx;
  border-left: 4rpx solid #5E7A73;
}

.shuowen-label {
  display: block;
  font-size: 22rpx;
  color: #5E7A73;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.shuowen-text {
  font-size: 26rpx;
  color: #6B6658;
  line-height: 1.7;
}

/* 字源释义 */
.char-detail-text {
  margin-top: 10rpx;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #9C9A92;
  margin-bottom: 6rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #5C5C5C;
  line-height: 1.7;
}

/* 诗词 */
.poetry-block {
  padding: 20rpx;
  background: #F4F0E7;
  border-radius: 12rpx;
  border-left: 6rpx solid #5E7A73;
}

.poetry-header {
  margin-bottom: 12rpx;
}

.poetry-source {
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: 500;
  display: block;
}

.poetry-author {
  font-size: 24rpx;
  color: #9C9A92;
  margin-top: 4rpx;
  display: block;
}

.poetry-text {
  font-size: 30rpx;
  color: #5C5C5C;
  line-height: 1.8;
  font-style: italic;
}

/* 音律 */
.phonetics-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.phon-row {
  display: flex;
  justify-content: space-between;
}

.phon-label {
  font-size: 28rpx;
  color: #5C5C5C;
}

.phon-value {
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: 500;
}

.phon-desc {
  font-size: 26rpx;
  color: #9C9A92;
  margin-top: 8rpx;
}

/* 五格 */
.wuge-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.wuge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuge-name {
  font-size: 24rpx;
  color: #9C9A92;
}

.wuge-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-top: 4rpx;
}

.wuge-luck {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.wuge-luck.luck-daji { color: #4CAF50; }
.wuge-luck.luck-ji { color: #8BC34A; }
.wuge-luck.luck-xiong { color: #e57373; }

.wuge-desc {
  font-size: 26rpx;
  color: #5C5C5C;
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #E2DED5;
}

/* 寓意 */
.meaning-text {
  font-size: 28rpx;
  color: #5C5C5C;
  line-height: 1.8;
}

.actions {
  padding: 20rpx 0 60rpx;
}

/* 深度寓意（多层余味） */
.deep-block {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #E2DED5;
}

.deep-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 16rpx;
}

.deep-loading {
  font-size: 26rpx;
  color: #9C9A92;
  padding: 20rpx 0;
}

.layer-item {
  padding: 16rpx 0;
}

.layer-item + .layer-item {
  border-top: 1rpx dashed #E2DED5;
}

.layer-level {
  display: inline-block;
  font-size: 22rpx;
  color: #5E7A73;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  background: #ECE8DE;
  margin-bottom: 8rpx;
}

.layer-text {
  font-size: 27rpx;
  color: #5C5C5C;
  line-height: 1.8;
}

.meaning-source {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B2B0A8;
  text-align: right;
}

/* 分享解锁遮罩 */
.unlock-mask {
  margin-top: 28rpx;
  padding: 40rpx 30rpx;
  border: 2rpx dashed #D8D2C6;
  border-radius: 16rpx;
  background: #F8F5EE;
  text-align: center;
}

.unlock-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.unlock-desc {
  font-size: 24rpx;
  color: #9C9A92;
  line-height: 1.6;
  margin: 16rpx 0 28rpx;
}

.unlock-btn {
  display: inline-block;
  width: 60%;
  margin: 0 auto;
}
