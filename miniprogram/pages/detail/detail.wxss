.name-display {
  text-align: center;
  padding: 50rpx 30rpx;
}

.name-main {
  font-size: 64rpx;
  font-weight: 500;
  color: #16181A;
  letter-spacing: 12rpx;
}

.name-pinyin {
  font-size: 28rpx;
  color: #4A4F55;
  margin-top: 12rpx;
}

.name-score {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
}

.score-label {
  font-size: 26rpx;
  color: #8A9099;
}

.score-number {
  font-size: 48rpx;
  font-weight: 500;
  color: #16181A;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #16181A;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A4F55;
}

/* 用字解析 */
.char-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E4E2DD;
}

.char-item:last-child {
  border-bottom: none;
}

.char-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
}

.char-text {
  font-size: 48rpx;
  font-weight: 500;
  color: #16181A;
}

.char-pinyin {
  font-size: 22rpx;
  color: #4A4F55;
  margin-top: 4rpx;
}

.char-detail {
  flex: 1;
}

.char-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #EFEDE8;
  color: #4A4F55;
}

.wuxing-tag.wx-jin { background: #EFEDE8; color: #8D7B4F; }
.wuxing-tag.wx-mu { background: #EFEDE8; color: #4E6B54; }
.wuxing-tag.wx-shui { background: #EFEDE8; color: #3E5A73; }
.wuxing-tag.wx-huo { background: #FBF1EE; color: #A6321F; }
.wuxing-tag.wx-tu { background: #EFEDE8; color: #7A6248; }

.char-meaning {
  font-size: 26rpx;
  color: #4A4F55;
  line-height: 1.5;
}

/* 说文解字 */
.char-shuowen {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #F7F6F3;
  border-radius: 4rpx;
  border-left: 4rpx solid #4A4F55;
}

.shuowen-label {
  display: block;
  font-size: 22rpx;
  color: #4A4F55;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.shuowen-text {
  font-size: 26rpx;
  color: #4A4F55;
  line-height: 1.7;
}

/* 字源释义 */
.char-detail-text {
  margin-top: 10rpx;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #8A9099;
  margin-bottom: 6rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #4A4F55;
  line-height: 1.7;
}

/* 诗词 */
.poetry-block {
  padding: 20rpx;
  background: #F7F6F3;
  border-radius: 4rpx;
  border-left: 6rpx solid #4A4F55;
}

.poetry-header {
  margin-bottom: 12rpx;
}

.poetry-source {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
  display: block;
}

.poetry-author {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 4rpx;
  display: block;
}

.poetry-text {
  font-size: 30rpx;
  color: #4A4F55;
  line-height: 1.8;
  font-style: italic;
}

/* 音律 */
.phonetics-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.phon-row {
  display: flex;
  justify-content: space-between;
}

.phon-label {
  font-size: 28rpx;
  color: #4A4F55;
}

.phon-value {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
}

.phon-desc {
  font-size: 26rpx;
  color: #8A9099;
  margin-top: 8rpx;
}

/* 五格 */
.wuge-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.wuge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuge-name {
  font-size: 24rpx;
  color: #8A9099;
}

.wuge-num {
  font-size: 36rpx;
  font-weight: 500;
  color: #16181A;
  margin-top: 4rpx;
}

.wuge-luck {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.wuge-luck.luck-daji { color: #4E6B54; }
.wuge-luck.luck-ji { color: #4E6B54; }
.wuge-luck.luck-xiong { color: #A6321F; }

.wuge-desc {
  font-size: 26rpx;
  color: #4A4F55;
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #E4E2DD;
}

/* 寓意 */
.meaning-text {
  font-size: 28rpx;
  color: #4A4F55;
  line-height: 1.8;
}

.actions {
  padding: 20rpx 0 60rpx;
}

/* 深度寓意（多层余味） */
.deep-block {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #E4E2DD;
}

.deep-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #16181A;
  margin-bottom: 16rpx;
}

.deep-loading {
  font-size: 26rpx;
  color: #8A9099;
  padding: 20rpx 0;
}

.layer-item {
  padding: 16rpx 0;
}

.layer-item + .layer-item {
  border-top: 1rpx dashed #E4E2DD;
}

.layer-level {
  display: inline-block;
  font-size: 22rpx;
  color: #4A4F55;
  font-weight: 500;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  background: #EFEDE8;
  margin-bottom: 8rpx;
}

.layer-text {
  font-size: 27rpx;
  color: #4A4F55;
  line-height: 1.8;
}

.meaning-source {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8A9099;
  text-align: right;
}

/* 分享解锁遮罩 */
.unlock-mask {
  margin-top: 28rpx;
  padding: 40rpx 30rpx;
  border: 2rpx dashed #C9CDD2;
  border-radius: 6rpx;
  background: #FFFFFF;
  text-align: center;
}

.unlock-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #16181A;
}

.unlock-desc {
  font-size: 24rpx;
  color: #8A9099;
  line-height: 1.6;
  margin: 16rpx 0 28rpx;
}

.unlock-btn {
  display: inline-block;
  width: 60%;
  margin: 0 auto;
}

/* 语境取义（同一字在不同诗句中含义不同） */
.char-senses {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.senses-label {
  font-size: 22rpx;
  color: #8A9099;
}

.sense-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.sense-chip {
  font-size: 22rpx;
  color: #4A4F55;
  background: #EFEDE8;
  border-radius: 3rpx;
  padding: 4rpx 14rpx;
}

.ctx-senses {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #F7F6F3;
  border-radius: 4rpx;
  border-left: 4rpx solid #4A4F55;
}

.ctx-title {
  font-size: 24rpx;
  color: #4A4F55;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.ctx-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.ctx-char {
  font-size: 30rpx;
  color: #16181A;
  font-weight: 500;
}

.ctx-arrow {
  font-size: 22rpx;
  color: #8A9099;
}

.ctx-words {
  font-size: 26rpx;
  color: #4A4F55;
}

.ctx-general {
  color: #8A9099;
}

.ctx-mark {
  font-size: 20rpx;
  color: #8A9099;
  border: 1rpx solid #C9CDD2;
  border-radius: 6rpx;
  padding: 0 8rpx;
}

.ctx-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8A9099;
  line-height: 1.5;
}
