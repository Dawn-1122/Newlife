.name-display {
  text-align: center;
  padding: 40rpx 30rpx;
}

.name-main {
  font-size: 64rpx;
  font-weight: 700;
  color: #8B4513;
  letter-spacing: 12rpx;
}

.name-pinyin {
  font-size: 28rpx;
  color: #C19A6B;
  margin-top: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #8B4513;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #C19A6B;
}

/* 用字解析 */
.char-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}

.char-item:last-child {
  border-bottom: none;
}

.char-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
}

.char-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
}

.char-pinyin {
  font-size: 22rpx;
  color: #C19A6B;
  margin-top: 4rpx;
}

.char-detail {
  flex: 1;
}

.char-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f5f3f0;
  color: #666;
}

.wuxing-tag.wx-jin { background: #FFF8E1; color: #C4A21E; }
.wuxing-tag.wx-mu { background: #E8F5E9; color: #4CAF50; }
.wuxing-tag.wx-shui { background: #E3F2FD; color: #2196F3; }
.wuxing-tag.wx-huo { background: #FBE9E7; color: #FF5722; }
.wuxing-tag.wx-tu { background: #EFEBE9; color: #8D6E63; }

.char-meaning {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 音律 / 八字 */
.phon-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.phon-label {
  font-size: 28rpx;
  color: #666;
}

.phon-value {
  font-size: 28rpx;
  color: #8B4513;
  font-weight: 500;
}

.phon-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 五格 */
.wuge-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.wuge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuge-name {
  font-size: 24rpx;
  color: #999;
}

.wuge-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #8B4513;
  margin-top: 4rpx;
}

.wuge-luck {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.wuge-luck.luck-daji { color: #4CAF50; }
.wuge-luck.luck-ji { color: #8BC34A; }
.wuge-luck.luck-xiong { color: #e57373; }

.wuge-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0ede8;
}

/* 诗词出处 */
.poetry-block {
  padding: 20rpx;
  background: #faf8f5;
  border-radius: 12rpx;
  border-left: 6rpx solid #C19A6B;
  margin-bottom: 16rpx;
}

.poetry-block:last-child {
  margin-bottom: 0;
}

.poetry-header {
  margin-bottom: 12rpx;
}

.poetry-source {
  font-size: 28rpx;
  color: #8B4513;
  font-weight: 500;
  display: block;
}

.poetry-author {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.poetry-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.8;
  font-style: italic;
}

.home-btn {
  margin-top: 10rpx;
}
