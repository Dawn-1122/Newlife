.name-display {
  text-align: center;
  padding: 40rpx 30rpx;
}

.name-main {
  font-size: 64rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 12rpx;
}

.name-pinyin {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--ink-2);
}

/* 用字解析 */
.char-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.char-item:last-child {
  border-bottom: none;
}

.char-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
}

.char-text {
  font-size: 48rpx;
  font-weight: 500;
  color: var(--ink);
}

.char-pinyin {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
}

.char-detail {
  flex: 1;
}

.char-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--paper-deep);
  color: var(--ink-2);
}

.wuxing-tag.wx-jin { background: var(--paper-deep); color: var(--wx-jin); }
.wuxing-tag.wx-mu { background: var(--paper-deep); color: var(--wx-mu); }
.wuxing-tag.wx-shui { background: var(--paper-deep); color: var(--wx-shui); }
.wuxing-tag.wx-huo { background: var(--cinnabar-bg); color: var(--wx-huo); }
.wuxing-tag.wx-tu { background: var(--paper-deep); color: var(--wx-tu); }

.char-meaning {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

/* 音律 / 八字 */
.phon-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.phon-label {
  font-size: 28rpx;
  color: var(--ink-2);
}

.phon-value {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.phon-desc {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* 五格 */
.wuge-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.wuge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuge-name {
  font-size: 24rpx;
  color: var(--ink-3);
}

.wuge-num {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 4rpx;
}

.wuge-luck {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.wuge-luck.luck-daji { color: var(--wx-mu); }
.wuge-luck.luck-ji { color: var(--wx-mu); }
.wuge-luck.luck-xiong { color: var(--cinnabar); }

.wuge-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

/* 诗词出处 */
.poetry-block {
  padding: 20rpx;
  background: var(--paper);
  border-radius: 4rpx;
  border-left: 6rpx solid var(--ink-2);
  margin-bottom: 16rpx;
}

.poetry-block:last-child {
  margin-bottom: 0;
}

.poetry-header {
  margin-bottom: 12rpx;
}

.poetry-source {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  display: block;
}

.poetry-author {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  display: block;
}

.poetry-text {
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1.8;
  font-style: italic;
}

.home-btn {
  margin-top: 10rpx;
}
