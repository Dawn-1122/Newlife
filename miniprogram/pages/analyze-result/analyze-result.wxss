.name-display {
  text-align: center;
  padding: 40rpx 30rpx;
}

.name-main {
  font-size: 64rpx;
  font-weight: 500;
  color: #16181A;
  letter-spacing: 12rpx;
}

.name-pinyin {
  font-size: 28rpx;
  color: #4A4F55;
  margin-top: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #16181A;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A4F55;
}

/* 用字解析 */
.char-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E4E2DD;
}

.char-item:last-child {
  border-bottom: none;
}

.char-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
}

.char-text {
  font-size: 48rpx;
  font-weight: 500;
  color: #16181A;
}

.char-pinyin {
  font-size: 22rpx;
  color: #4A4F55;
  margin-top: 4rpx;
}

.char-detail {
  flex: 1;
}

.char-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #EFEDE8;
  color: #4A4F55;
}

.wuxing-tag.wx-jin { background: #EFEDE8; color: #8D7B4F; }
.wuxing-tag.wx-mu { background: #EFEDE8; color: #4E6B54; }
.wuxing-tag.wx-shui { background: #EFEDE8; color: #3E5A73; }
.wuxing-tag.wx-huo { background: #FBF1EE; color: #A6321F; }
.wuxing-tag.wx-tu { background: #EFEDE8; color: #7A6248; }

.char-meaning {
  font-size: 26rpx;
  color: #4A4F55;
  line-height: 1.5;
}

/* 音律 / 八字 */
.phon-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.phon-label {
  font-size: 28rpx;
  color: #4A4F55;
}

.phon-value {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
}

.phon-desc {
  font-size: 26rpx;
  color: #8A9099;
  margin-top: 8rpx;
}

/* 五格 */
.wuge-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.wuge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuge-name {
  font-size: 24rpx;
  color: #8A9099;
}

.wuge-num {
  font-size: 36rpx;
  font-weight: 500;
  color: #16181A;
  margin-top: 4rpx;
}

.wuge-luck {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.wuge-luck.luck-daji { color: #4E6B54; }
.wuge-luck.luck-ji { color: #4E6B54; }
.wuge-luck.luck-xiong { color: #A6321F; }

.wuge-desc {
  font-size: 26rpx;
  color: #4A4F55;
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #E4E2DD;
}

/* 诗词出处 */
.poetry-block {
  padding: 20rpx;
  background: #F7F6F3;
  border-radius: 4rpx;
  border-left: 6rpx solid #4A4F55;
  margin-bottom: 16rpx;
}

.poetry-block:last-child {
  margin-bottom: 0;
}

.poetry-header {
  margin-bottom: 12rpx;
}

.poetry-source {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
  display: block;
}

.poetry-author {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 4rpx;
  display: block;
}

.poetry-text {
  font-size: 30rpx;
  color: #4A4F55;
  line-height: 1.8;
  font-style: italic;
}

.home-btn {
  margin-top: 10rpx;
}
