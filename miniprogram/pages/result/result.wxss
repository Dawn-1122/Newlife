/* 结果页 · 山水泼墨 */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.band {
  width: 100%;
  overflow: hidden;
}

.band-img {
  width: 100%;
  display: block;
}

.container {
  padding: 32rpx 40rpx 0;
  box-sizing: border-box;
}

.fallback-note {
  padding: 20rpx 24rpx;
  background: var(--paper-deep);
  border-radius: 4rpx;
  border-left: 6rpx solid var(--cinnabar);
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--ochre);
}

.adjust-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 6rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.adjust-text {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.adjust-more {
  font-size: 30rpx;
  color: var(--ink-2);
}

.bazi-summary {
  text-align: center;
}

.bazi-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.bazi-more {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.bazi-summary {
  position: relative;
}

.bazi-pillars {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pillar-label {
  font-size: 24rpx;
  color: var(--ink-3);
}

.pillar-value {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 8rpx;
}

.bazi-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 20rpx;
}

.wuxing-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.wuxing-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuxing-label {
  font-size: 28rpx;
  font-weight: 500;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: var(--card);
}

.wuxing-label.wx-jin { background: var(--wx-jin); }
.wuxing-label.wx-mu { background: var(--wx-mu); }
.wuxing-label.wx-shui { background: var(--wx-shui); }
.wuxing-label.wx-huo { background: var(--wx-huo); }
.wuxing-label.wx-tu { background: var(--wx-tu); }

.wuxing-percent {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

/* 名字卡片 */
.name-card {
  position: relative;
}

.name-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 收藏：默认低调（墨阶），已收藏才用朱砂 —— 朱砂只留给「选中」 */
.fav-btn {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 4rpx 16rpx;
}

.fav-btn.fav-on {
  color: var(--cinnabar);
  border-color: var(--cinnabar);
  background: var(--cinnabar-bg);
}

.name-text {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.name-pinyin {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

.name-poetry {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--paper);
  border-radius: 3rpx;
  border-left: 6rpx solid var(--ink-2);
}

.poetry-source {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.poetry-text {
  font-size: 26rpx;
  color: var(--ink-2);
  display: block;
}

.name-scores {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-label {
  font-size: 22rpx;
  color: var(--ink-3);
}

.score-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.name-meaning {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--ink-3);
}

/* 筛选栏 */
.filter-bar {
  background: var(--card);
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.filter-head-title {
  font-family: var(--serif);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.filter-reset {
  font-size: 24rpx;
  color: var(--cinnabar);
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.filter-row + .filter-row {
  border-top: 1rpx solid var(--line);
}

.filter-label {
  flex-shrink: 0;
  width: 80rpx;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  padding-top: 8rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

/* 出处/用字项数不定，走横向滚动而不是换行堆高 */
.filter-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.chip-inline-wrap {
  display: inline-block;
  white-space: nowrap;
  padding: 4rpx 0;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: var(--r-sm);
  font-size: 26rpx;
  color: var(--ink-2);
  background: var(--paper-deep);
  line-height: 1.4;
}

.chip-inline {
  display: inline-block;
  margin-right: 12rpx;
}

.chip-active {
  background: var(--ink);
  color: var(--card);
  font-weight: 500;
}

/* 底部操作 */
.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.refresh-btn,
.home-btn {
  flex: 1;
}

.home-btn {
  margin-top: 0;
}
