.fallback-note {
  padding: 20rpx 24rpx;
  background: #F6EFDF;
  border-radius: 12rpx;
  border-left: 6rpx solid #A93226;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #7A6A45;
}

.adjust-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.adjust-text {
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: 500;
}

.adjust-more {
  font-size: 30rpx;
  color: #5E7A73;
}

.bazi-summary {
  text-align: center;
}

.bazi-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 20rpx;
}

.bazi-more {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #5E7A73;
}

.bazi-summary {
  position: relative;
}

.bazi-pillars {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pillar-label {
  font-size: 24rpx;
  color: #9C9A92;
}

.pillar-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-top: 8rpx;
}

.bazi-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #5C5C5C;
  margin-bottom: 20rpx;
}

.wuxing-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #E2DED5;
}

.wuxing-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuxing-label {
  font-size: 28rpx;
  font-weight: 600;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff;
}

.wuxing-label.wx-jin { background: #C4A21E; }
.wuxing-label.wx-mu { background: #4CAF50; }
.wuxing-label.wx-shui { background: #2196F3; }
.wuxing-label.wx-huo { background: #FF5722; }
.wuxing-label.wx-tu { background: #8D6E63; }

.wuxing-percent {
  font-size: 22rpx;
  color: #9C9A92;
  margin-top: 6rpx;
}

/* 名字卡片 */
.name-card {
  position: relative;
}

.name-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 4rpx;
}

.name-pinyin {
  font-size: 24rpx;
  color: #5E7A73;
  margin-top: 8rpx;
}

.name-poetry {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F4F0E7;
  border-radius: 8rpx;
  border-left: 6rpx solid #5E7A73;
}

.poetry-source {
  font-size: 24rpx;
  color: #1F1F1F;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.poetry-text {
  font-size: 26rpx;
  color: #5C5C5C;
  display: block;
}

.name-scores {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-label {
  font-size: 22rpx;
  color: #9C9A92;
}

.score-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.name-meaning {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5C5C5C;
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #9C9A92;
}

/* 筛选栏 */
.filter-bar {
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.filter-row + .filter-row {
  border-top: 1rpx solid #E2DED5;
}

.filter-label {
  flex-shrink: 0;
  width: 80rpx;
  font-size: 26rpx;
  color: #1F1F1F;
  font-weight: 600;
  padding-top: 8rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #5C5C5C;
  background: #ECE8DE;
  line-height: 1.4;
}

.chip-active {
  background: linear-gradient(135deg, #1F1F1F, #3A3A3A);
  color: #fff;
  font-weight: 500;
}

/* 底部操作 */
.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.refresh-btn,
.home-btn {
  flex: 1;
}

.home-btn {
  margin-top: 0;
}
