/* 结果页 · 山水泼墨 */

.page {
  min-height: 100vh;
  /* 给固定操作坞留位置：不留的话最后一张名字卡会被压在坞下面
     （坞高约 138rpx = 上下 20 + 按钮 98），这里多留一点余量。
     先写一行不含 env() 的值：万一某个宿主不认 env()，整条 calc 会失效，
     那时宁可少让一点，也不能一让让成 0。 */
  padding-bottom: 180rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 补次数面板展开时坞会变高，内容区要跟着多让出空间，
   否则最后一张卡被面板压住、又滚不上来。 */
.page-with-sheet {
  padding-bottom: 560rpx;
  padding-bottom: calc(560rpx + env(safe-area-inset-bottom));
}

.container {
  padding: 32rpx 40rpx 0;
  box-sizing: border-box;
}

.fallback-note {
  padding: 20rpx 24rpx;
  background: var(--paper-deep);
  border-radius: 4rpx;
  border-left: 6rpx solid var(--cinnabar);
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--ochre);
}

.adjust-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 6rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.adjust-text {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.adjust-more {
  font-size: 30rpx;
  color: var(--ink-2);
}

.bazi-summary {
  position: relative;
  text-align: left;
}

.bazi-head {
  display: flex;
  align-items: center;
}

.bazi-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  flex-shrink: 0;
}

.bazi-sub {
  flex: 1;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bazi-more {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.bazi-body {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.bazi-pillars {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pillar-label {
  font-size: 24rpx;
  color: var(--ink-3);
}

.pillar-value {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  margin-top: 8rpx;
}

/* 时柱未填：不用「补一个数」的方式填满格子，而是如实说明没填 */
.pillar-value.pillar-unknown {
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.bazi-note {
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ochre);
  background: var(--paper-deep);
  border-radius: var(--r-sm);
}

.bazi-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 20rpx;
}

.wuxing-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.wuxing-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuxing-label {
  font-size: 28rpx;
  font-weight: 500;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: var(--card);
}

.wuxing-label.wx-jin { background: var(--wx-jin); }
.wuxing-label.wx-mu { background: var(--wx-mu); }
.wuxing-label.wx-shui { background: var(--wx-shui); }
.wuxing-label.wx-huo { background: var(--wx-huo); }
.wuxing-label.wx-tu { background: var(--wx-tu); }

.wuxing-percent {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

/* 名字卡片 */
.name-card {
  position: relative;
}

.name-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 收藏：默认低调（墨阶），已收藏才用朱砂 —— 朱砂只留给「选中」 */
.fav-btn {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 4rpx 16rpx;
}

.fav-btn.fav-on {
  color: var(--cinnabar);
  border-color: var(--cinnabar);
  background: var(--cinnabar-bg);
}

.name-text {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.name-meaning {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

/* 契合点：细线分隔而不是加底色块 —— 卡片里再套一个色块会变成三层框，
   与「去阴影、用细线分层」的版式原则相冲。 */
.name-fit {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
  font-size: 23rpx;
  line-height: 1.6;
}

.fit-tag {
  color: var(--ochre);
  font-weight: 500;
  margin-right: 8rpx;
}

.fit-text {
  color: var(--ink-2);
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--ink-3);
}

/* 筛选栏 */
.filter-bar {
  background: var(--card);
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.filter-head-title {
  font-family: var(--serif);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.filter-reset {
  font-size: 24rpx;
  color: var(--cinnabar);
}

.filter-head-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.filter-toggle {
  font-size: 24rpx;
  color: var(--ink-2);
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.filter-row + .filter-row {
  border-top: 1rpx solid var(--line);
}

.filter-label {
  flex-shrink: 0;
  width: 80rpx;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  padding-top: 8rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

/* 出处/用字项数不定，走横向滚动而不是换行堆高 */
.filter-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.chip-inline-wrap {
  display: inline-block;
  white-space: nowrap;
  padding: 4rpx 0;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: var(--r-sm);
  font-size: 26rpx;
  color: var(--ink-2);
  background: var(--paper-deep);
  line-height: 1.4;
}

.chip-inline {
  display: inline-block;
  margin-right: 12rpx;
}

.chip-active {
  background: var(--ink);
  color: var(--card);
  font-weight: 500;
}

/* 底部操作坞 */
.bottom-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  /* 底部安全区：全面屏机器上不垫这一层，按钮会被 Home 条压住一半。
     同样先给一行不含 env() 的兜底值，避免整条 calc 被判无效。 */
  padding: 20rpx 40rpx 20rpx;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}

.footer-actions {
  display: flex;
  gap: 20rpx;
}

.refresh-btn,
.home-btn {
  flex: 1;
}

.home-btn {
  margin-top: 0;
}

/* ── 补次数面板（今天的换一批用完之后才出现）──
   它从按钮上方展开，是「贴着按钮的浮层」，不是页面末尾的一块内容：
   用户刚点完那次没成功的换一批，眼睛就在按钮上，面板得在那里出现。
   刻意比主按钮低一级 —— 这一屏的主角是名字，补次数是旁支。 */
.quota-panel {
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx;
  background: var(--paper-deep);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}

.quota-title {
  font-family: var(--serif);
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.quota-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ochre);
}

.quota-btn {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.5;
  color: var(--ink);
  text-align: center;
}

.quota-btn:active {
  background: var(--paper);
}

/* 广告位未开通 / 今日已领完：仍然可点，点了会说清原因。
   不用灰掉的禁用态 —— 一个点不动的块不会告诉用户为什么点不动。 */
.quota-btn-off {
  background: transparent;
  border-color: var(--line);
  color: var(--ink-3);
}
