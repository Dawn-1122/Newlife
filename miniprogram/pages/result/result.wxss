/* 结果页 · 山水泼墨 */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.band {
  width: 100%;
  overflow: hidden;
}

.band-img {
  width: 100%;
  display: block;
}

.container {
  padding: 32rpx 40rpx 0;
  box-sizing: border-box;
}

.fallback-note {
  padding: 20rpx 24rpx;
  background: #EFEDE8;
  border-radius: 4rpx;
  border-left: 6rpx solid #A6321F;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #8D7B4F;
}

.adjust-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 6rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.adjust-text {
  font-size: 28rpx;
  color: #16181A;
  font-weight: 500;
}

.adjust-more {
  font-size: 30rpx;
  color: #4A4F55;
}

.bazi-summary {
  text-align: center;
}

.bazi-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #16181A;
  margin-bottom: 20rpx;
}

.bazi-more {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #4A4F55;
}

.bazi-summary {
  position: relative;
}

.bazi-pillars {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pillar-label {
  font-size: 24rpx;
  color: #8A9099;
}

.pillar-value {
  font-size: 36rpx;
  font-weight: 500;
  color: #16181A;
  margin-top: 8rpx;
}

.bazi-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #4A4F55;
  margin-bottom: 20rpx;
}

.wuxing-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #E4E2DD;
}

.wuxing-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wuxing-label {
  font-size: 28rpx;
  font-weight: 500;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: #FFFFFF;
}

.wuxing-label.wx-jin { background: #8D7B4F; }
.wuxing-label.wx-mu { background: #4E6B54; }
.wuxing-label.wx-shui { background: #3E5A73; }
.wuxing-label.wx-huo { background: #A6321F; }
.wuxing-label.wx-tu { background: #7A6248; }

.wuxing-percent {
  font-size: 22rpx;
  color: #8A9099;
  margin-top: 6rpx;
}

/* 名字卡片 */
.name-card {
  position: relative;
}

.name-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name-text {
  font-size: 40rpx;
  font-weight: 500;
  color: #16181A;
  letter-spacing: 4rpx;
}

.name-pinyin {
  font-size: 24rpx;
  color: #4A4F55;
  margin-top: 8rpx;
}

.name-poetry {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F7F6F3;
  border-radius: 3rpx;
  border-left: 6rpx solid #4A4F55;
}

.poetry-source {
  font-size: 24rpx;
  color: #16181A;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.poetry-text {
  font-size: 26rpx;
  color: #4A4F55;
  display: block;
}

.name-scores {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-label {
  font-size: 22rpx;
  color: #8A9099;
}

.score-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #16181A;
}

.name-meaning {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #4A4F55;
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #8A9099;
}

/* 筛选栏 */
.filter-bar {
  background: #FFFFFF;
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.filter-head-title {
  font-family: var(--serif);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #16181A;
}

.filter-reset {
  font-size: 24rpx;
  color: #A6321F;
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.filter-row + .filter-row {
  border-top: 1rpx solid #E4E2DD;
}

.filter-label {
  flex-shrink: 0;
  width: 80rpx;
  font-size: 26rpx;
  color: #16181A;
  font-weight: 500;
  padding-top: 8rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

/* 出处/用字项数不定，走横向滚动而不是换行堆高 */
.filter-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.chip-inline-wrap {
  display: inline-block;
  white-space: nowrap;
  padding: 4rpx 0;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: var(--r-sm);
  font-size: 26rpx;
  color: #4A4F55;
  background: #EFEDE8;
  line-height: 1.4;
}

.chip-inline {
  display: inline-block;
  margin-right: 12rpx;
}

.chip-active {
  background: #16181A;
  color: #FFFFFF;
  font-weight: 500;
}

/* 底部操作 */
.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.refresh-btn,
.home-btn {
  flex: 1;
}

.home-btn {
  margin-top: 0;
}
