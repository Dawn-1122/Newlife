<wxs module="m">
  var wuxingMap = { '金': 'wx-jin', '木': 'wx-mu', '水': 'wx-shui', '火': 'wx-huo', '土': 'wx-tu' }
  module.exports = {
    wx: function(v) { return wuxingMap[v] || '' }
  }
</wxs>
<view class="container">
  <!-- 八字摘要 -->
  <view class="card bazi-summary" wx:if="{{bazi}}" bindtap="onBaziTap">
    <view class="bazi-title">八字排盘</view>
    <view class="bazi-more">查看详解 ›</view>
    <view class="bazi-pillars">
      <view class="pillar">
        <text class="pillar-label">年柱</text>
        <text class="pillar-value">{{bazi.four_pillars.year}}</text>
      </view>
      <view class="pillar">
        <text class="pillar-label">月柱</text>
        <text class="pillar-value">{{bazi.four_pillars.month}}</text>
      </view>
      <view class="pillar">
        <text class="pillar-label">日柱</text>
        <text class="pillar-value">{{bazi.four_pillars.day}}</text>
      </view>
      <view class="pillar">
        <text class="pillar-label">时柱</text>
        <text class="pillar-value">{{bazi.four_pillars.hour}}</text>
      </view>
    </view>
    <view class="bazi-info">
      <text>日主: {{bazi.day_master}} ({{bazi.day_master_wuxing}})</text>
      <text>{{bazi.xiyong.strength_label}} · 喜用神: {{xiyongText}}</text>
    </view>
    <view class="wuxing-bar">
      <view class="wuxing-item" wx:for="{{wuxingList}}" wx:key="name">
        <view class="wuxing-label {{m.wx(item.name)}}">{{item.name}}</view>
        <view class="wuxing-percent">{{item.percent}}%</view>
      </view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-row">
      <text class="filter-label">五行</text>
      <view class="filter-chips">
        <view
          class="chip {{wuxingFilter === item.code ? 'chip-active' : ''}}"
          wx:for="{{wuxingFilters}}"
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="onWuxingFilterTap"
        >{{item.name}}</view>
      </view>
    </view>
    <view class="filter-row">
      <text class="filter-label">风格</text>
      <view class="filter-chips">
        <view
          class="chip {{styleFilter === item.code ? 'chip-active' : ''}}"
          wx:for="{{styleFilters}}"
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="onStyleFilterTap"
        >{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 名字列表 -->
  <view class="name-list">
    <view class="card name-card" wx:for="{{names}}" wx:key="full_name" bindtap="onNameTap" data-index="{{index}}">
      <view class="name-header">
        <text class="name-text">{{item.full_name}}</text>
        <view class="score-badge {{item.scores.overall >= 85 ? 'score-high' : item.scores.overall >= 70 ? 'score-mid' : 'score-low'}}">
          {{item.scores.overall}}分
        </view>
      </view>

      <view class="name-pinyin">{{item.pinyinText}}</view>

      <view class="name-poetry" wx:if="{{item.poetry}}">
        <text class="poetry-source">「{{item.poetry.source}}·{{item.poetry.title}}」</text>
        <text class="poetry-text">{{item.poetry.text}}</text>
      </view>

      <view class="name-scores">
        <view class="score-item">
          <text class="score-label">音律</text>
          <text class="score-value">{{item.scores.phonetics}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">五格</text>
          <text class="score-value">{{item.scores.wuge}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">八字</text>
          <text class="score-value">{{item.scores.bazi}}</text>
        </view>
      </view>

      <view class="name-meaning">{{item.meaning}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!names.length}}">
    <text>{{loading ? '加载中…' : '暂无结果，请调整筛选条件后重试'}}</text>
  </view>

  <!-- 底部操作 -->
  <view class="footer-actions">
    <button class="btn-primary refresh-btn" bindtap="onRefresh" loading="{{loading}}" disabled="{{loading}}">换一批</button>
    <button class="btn-primary home-btn" bindtap="onBackHome">返回首页</button>
  </view>
</view>
