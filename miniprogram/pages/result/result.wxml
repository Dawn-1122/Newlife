<wxs module="m">
  var wuxingMap = { '金': 'wx-jin', '木': 'wx-mu', '水': 'wx-shui', '火': 'wx-huo', '土': 'wx-tu' }
  module.exports = {
    wx: function(v) { return wuxingMap[v] || '' }
  }
</wxs>

<view class="page">
  <view class="container">
    <!-- 强加权降级提示 -->
    <view class="fallback-note" wx:if="{{fallbackNote}}">
      <text>{{fallbackNote}}</text>
    </view>

    <!-- 八字排盘（默认折叠成一行，点开展开） -->
    <view class="card bazi-summary" wx:if="{{bazi}}">
      <view class="bazi-head" bindtap="onBaziToggle">
        <view class="bazi-title">八字排盘</view>
        <view class="bazi-sub" wx:if="{{!baziOpen}}">喜用神 · {{xiyongText}}</view>
        <view class="bazi-more" catchtap="onBaziTap">查看详解 ›</view>
      </view>

      <view class="bazi-body" wx:if="{{baziOpen}}">
        <view class="bazi-pillars">
          <view class="pillar">
            <text class="pillar-label">年柱</text>
            <text class="pillar-value">{{bazi.four_pillars.year}}</text>
          </view>
          <view class="pillar">
            <text class="pillar-label">月柱</text>
            <text class="pillar-value">{{bazi.four_pillars.month}}</text>
          </view>
          <view class="pillar">
            <text class="pillar-label">日柱</text>
            <text class="pillar-value">{{bazi.four_pillars.day}}</text>
          </view>
          <view class="pillar">
            <text class="pillar-label">时柱</text>
            <text class="pillar-value" wx:if="{{hourKnown}}">{{bazi.four_pillars.hour}}</text>
            <text class="pillar-value pillar-unknown" wx:else>未填</text>
          </view>
        </view>
        <view class="bazi-note" wx:if="{{!hourKnown}}">
          时辰未填。排盘暂以午时代入，喜用神与五行比重会随时辰变，补上更准。
        </view>
        <view class="bazi-info">
          <text>日主: {{bazi.day_master}} ({{bazi.day_master_wuxing}})</text>
          <text>{{bazi.xiyong.strength_label}} · 喜用神: {{xiyongText}}</text>
        </view>
        <view class="wuxing-bar">
          <view class="wuxing-item" wx:for="{{wuxingList}}" wx:key="name">
            <view class="wuxing-label {{m.wx(item.name)}}">{{item.name}}</view>
            <view class="wuxing-percent">{{item.percent}}%</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 筛选栏：默认只显示五行，其余折叠 -->
    <view class="filter-bar">
      <view class="filter-head">
        <text class="filter-head-title">筛选</text>
        <view class="filter-head-right">
          <text class="filter-reset" bindtap="onResetFilter">重置</text>
          <text class="filter-toggle" bindtap="onToggleFilter">{{filterOpen ? '收起' : '展开'}}</text>
        </view>
      </view>

      <view class="filter-row">
        <text class="filter-label">五行</text>
        <view class="filter-chips">
          <view
            class="chip {{wuxingFilter === item.code ? 'chip-active' : ''}}"
            wx:for="{{wuxingFilters}}"
            wx:key="code"
            data-code="{{item.code}}"
            bindtap="onWuxingFilterTap"
          >{{item.name}}</view>
        </view>
      </view>

      <block wx:if="{{filterOpen}}">
        <view class="filter-row">
          <text class="filter-label">风格</text>
          <view class="filter-chips">
            <view
              class="chip {{styleFilter === item.code ? 'chip-active' : ''}}"
              wx:for="{{styleFilters}}"
              wx:key="code"
              data-code="{{item.code}}"
              bindtap="onStyleFilterTap"
            >{{item.name}}</view>
          </view>
        </view>

        <!-- 出处与用字原先在起名向导里选，现改为生成后收敛 -->
        <view class="filter-row">
          <text class="filter-label">出处</text>
          <scroll-view class="filter-scroll" scroll-x>
            <view class="chip-inline-wrap">
              <view
                class="chip chip-inline {{sourceFilter === item.code ? 'chip-active' : ''}}"
                wx:for="{{sourceFilters}}"
                wx:key="code"
                data-code="{{item.code}}"
                bindtap="onSourceFilterTap"
              >{{item.name}}</view>
            </view>
          </scroll-view>
        </view>

        <view class="filter-row" wx:if="{{charFilters.length}}">
          <text class="filter-label">用字</text>
          <scroll-view class="filter-scroll" scroll-x>
            <view class="chip-inline-wrap">
              <view
                class="chip chip-inline {{charFilter === item.code ? 'chip-active' : ''}}"
                wx:for="{{charFilters}}"
                wx:key="code"
                data-code="{{item.code}}"
                bindtap="onCharFilterTap"
              >{{item.name}}</view>
            </view>
          </scroll-view>
        </view>
      </block>
    </view>

    <!-- 调整偏好 -->
    <view class="adjust-bar" bindtap="onAdjustPref">
      <text class="adjust-text">调整偏好</text>
      <text class="adjust-more">›</text>
    </view>

    <!-- 名字列表（精简：名字 + 推荐值 + 一句寓意，细节收进详情页） -->
    <view class="name-list">
      <view class="card name-card" wx:for="{{names}}" wx:key="full_name" bindtap="onNameTap" data-index="{{index}}">
        <view class="name-header">
          <text class="name-text">{{item.full_name}}</text>
          <view class="name-header-right">
            <view class="score-badge {{item.tier}}">
              <text class="score-label">推荐值</text><text class="score-num">{{item.recommend}}</text>
            </view>
            <text
              class="fav-btn {{item.fav ? 'fav-on' : ''}}"
              catchtap="onFavTap"
              data-index="{{index}}"
            >{{item.fav ? '已收藏' : '收藏'}}</text>
          </view>
        </view>

        <view class="name-meaning">{{item.meaning}}</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!names.length}}">
      <text>{{loading ? '加载中…' : '暂无结果，请调整筛选条件后重试'}}</text>
    </view>

    <!-- 底部操作 -->
    <view class="footer-actions">
      <button class="btn-secondary refresh-btn" bindtap="onRefresh" loading="{{loading}}" disabled="{{loading}}">换一批</button>
      <button class="btn-primary home-btn" bindtap="onBackHome">返回首页</button>
    </view>
  </view>
</view>
