/* 分享落地页
   目的只有一个：让收到分享的人觉得「这名字有来处」，然后自己去起一个。
   故版式按画册排：大字名字开场，细线分区，朱砂只出现在印章与主行动两处。 */

.page {
  padding: 0 40rpx 60rpx;
  box-sizing: border-box;
}

/* ── 加载 / 错误态 ── */
.state {
  padding: 200rpx 0 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-mark {
  width: 88rpx;
  height: 88rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: var(--r-sm);
  font-family: var(--serif);
  font-size: 48rpx;
  line-height: 88rpx;
  text-align: center;
}

.state-text {
  margin-top: 28rpx;
  font-size: 27rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.state-btn {
  width: 60%;
  margin-top: 48rpx;
}

/* ── ① 名字主卡 ── */
.hero {
  padding: 90rpx 0 70rpx;
  text-align: center;
}

.hero-kicker {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 10rpx;
  /* 字距补右内边距，否则整行视觉偏左 */
  padding-left: 10rpx;
}

.hero-name {
  margin-top: 36rpx;
  font-family: var(--serif);
  font-size: 96rpx;
  font-weight: 500;
  line-height: 1.25;
  color: var(--ink);
  letter-spacing: 16rpx;
  padding-left: 16rpx;
}

.hero-pinyin {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  letter-spacing: 3rpx;
}

.hero-rule {
  width: 72rpx;
  height: 2rpx;
  margin: 40rpx auto 0;
  background: var(--line-strong);
}

.hero-cite {
  margin-top: 30rpx;
  font-family: var(--serif);
  font-size: 28rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.hero-cite-quiet {
  color: var(--ink-3);
  font-size: 25rpx;
}

/* ── 分区标题 ── */
.sec-title {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 6rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--line-strong);
  margin-bottom: 28rpx;
}

/* ── ② 出处 ── */
.poem-head {
  padding-left: 2rpx;
}

.poem-cite {
  display: block;
  font-family: var(--serif);
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.poem-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.poem-text {
  margin-top: 26rpx;
  padding: 26rpx 24rpx;
  background: var(--paper);
  border-radius: var(--r-sm);
  font-family: var(--serif);
  font-size: 36rpx;
  line-height: 1.9;
  color: var(--ink-2);
  letter-spacing: 3rpx;
}

/* 名字用字：朱砂 + 下划细线，克制到不抢字形 */
.poem-hit {
  color: var(--cinnabar);
  font-weight: 500;
  border-bottom: 2rpx solid var(--cinnabar);
}

.poem-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── ③ 逐字解析 ── */
.char {
  padding: 30rpx 0;
  border-top: 1rpx solid var(--line);
}

.char:first-of-type {
  border-top: none;
  padding-top: 4rpx;
}

.char:last-child {
  padding-bottom: 4rpx;
}

.char-head {
  display: flex;
  align-items: center;
}

.char-glyph {
  font-family: var(--serif);
  font-size: 76rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--ink);
  width: 108rpx;
  flex-shrink: 0;
}

.char-meta {
  flex: 1;
  min-width: 0;
}

.char-pinyin {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.char-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.tag {
  font-size: 21rpx;
  padding: 3rpx 12rpx;
  border-radius: var(--r-sm);
  background: var(--paper-deep);
  color: var(--ink-2);
}

.tag.wx-jin { color: var(--wx-jin); }
.tag.wx-mu { color: var(--wx-mu); }
.tag.wx-shui { color: var(--wx-shui); }
.tag.wx-huo { background: var(--cinnabar-bg); color: var(--wx-huo); }
.tag.wx-tu { color: var(--wx-tu); }

.char-senses {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.senses-label {
  font-size: 21rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.senses-value {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}

.char-meaning {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* ── ④ 余味 ── */
.mellow {
  margin: 30rpx 0 10rpx;
  padding: 40rpx 34rpx;
  border-top: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
  text-align: center;
}

.mellow-label {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 8rpx;
  padding-left: 8rpx;
}

.mellow-text {
  margin-top: 22rpx;
  font-family: var(--serif);
  font-size: 31rpx;
  line-height: 1.85;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.mellow-more {
  margin-top: 26rpx;
  font-size: 25rpx;
  color: var(--cinnabar);
  letter-spacing: 1rpx;
}

/* ── ⑤ 小程序码位 ── */
.qr-block {
  padding: 60rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-box {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--r-sm);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.qr-img {
  width: 100%;
  height: 100%;
}

.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 印章式占位：比一个灰色方块更像个「待盖的印」 */
.qr-mark {
  width: 84rpx;
  height: 84rpx;
  background: var(--paper-deep);
  color: var(--line-strong);
  border-radius: var(--r-sm);
  font-family: var(--serif);
  font-size: 46rpx;
  line-height: 84rpx;
  text-align: center;
}

.qr-hint {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 3rpx;
}

.qr-copy {
  margin-top: 26rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  text-align: center;
}

/* ── ⑥⑦ CTA ── */
.cta {
  padding: 40rpx 0 0;
}

.cta-second {
  margin-top: 20rpx;
}

/* ── ⑧ 页脚 ── */
.foot {
  padding: 56rpx 0 20rpx;
  text-align: center;
  font-family: var(--serif);
  font-size: 22rpx;
  color: var(--line-strong);
  letter-spacing: 6rpx;
  padding-left: 6rpx;
}
