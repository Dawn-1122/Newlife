<view class="container">
  <!-- 标题区 -->
  <view class="header">
    <view class="title">美名集</view>
    <view class="subtitle">有据可循的起名工具</view>
    <view class="tagline">诗词典故 · 五行音律 · 每个名字都有出处</view>
  </view>

  <!-- 表单区 -->
  <view class="card form-card">
    <!-- 姓氏 -->
    <view class="form-item">
      <text class="form-label">姓氏</text>
      <input class="form-input" placeholder="请输入姓氏" value="{{surname}}" bindinput="onSurnameInput" maxlength="2" />
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="form-label">性别</text>
      <view class="gender-tabs">
        <view class="gender-tab {{gender === 'male' ? 'active' : ''}}" bindtap="onGenderTap" data-gender="male">男孩</view>
        <view class="gender-tab {{gender === 'female' ? 'active' : ''}}" bindtap="onGenderTap" data-gender="female">女孩</view>
      </view>
    </view>

    <!-- 是否使用八字 -->
    <view class="form-item">
      <text class="form-label">八字分析</text>
      <switch checked="{{useBazi}}" bindchange="onBaziSwitch" color="#8B4513" />
    </view>

    <!-- 出生时间 -->
    <view class="form-item" wx:if="{{useBazi}}">
      <text class="form-label">出生时间</text>
      <picker mode="date" value="{{birthDate}}" start="1900-01-01" end="2100-12-31" bindchange="onDateChange">
        <view class="picker-value">{{birthDate || '请选择日期'}}</view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{useBazi}}">
      <text class="form-label">出生时辰</text>
      <picker mode="selector" range="{{hourOptions}}" value="{{hourIndex}}" bindchange="onHourChange">
        <view class="picker-value">{{hourOptions[hourIndex]}}</view>
      </picker>
    </view>

    <!-- 名字字数 -->
    <view class="form-item">
      <text class="form-label">名字字数</text>
      <view class="length-tabs">
        <view class="length-tab {{nameLength === 1 ? 'active' : ''}}" bindtap="onLengthTap" data-length="1">单字名</view>
        <view class="length-tab {{nameLength === 2 ? 'active' : ''}}" bindtap="onLengthTap" data-length="2">双字名</view>
      </view>
    </view>
  </view>

  <!-- 起名按钮 -->
  <button class="btn-primary" bindtap="onGenerateTap" loading="{{loading}}">开始起名</button>

  <!-- 底部说明 -->
  <view class="footer-note">
    <text>每个名字附诗词出处、五行分析、音律评分</text>
    <text>数据仅供参考，起名是一件慎重的事</text>
  </view>
</view>
