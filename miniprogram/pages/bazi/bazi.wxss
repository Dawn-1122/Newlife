/* 八字详解页样式 */

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid var(--ink-2);
}

/* 五行标签 */
.wuxing-tag {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--card);
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 4rpx;
}
.wuxing-tag.wx-jin { background: var(--wx-jin); }
.wuxing-tag.wx-mu { background: var(--wx-mu); }
.wuxing-tag.wx-shui { background: var(--wx-shui); }
.wuxing-tag.wx-huo { background: var(--wx-huo); }
.wuxing-tag.wx-tu { background: var(--wx-tu); }

/* 头部总览 */
.bazi-header {
  text-align: center;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
}

.header-shengxiao {
  color: var(--ink-2);
}

.day-master {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.dm-label {
  font-size: 26rpx;
  color: var(--ink-3);
}

.dm-value {
  font-size: 60rpx;
  font-weight: 500;
  color: var(--ink);
}

.header-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 四柱详解 */
.pillar-detail {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pillar-detail:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.pillar-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.pillar-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  /* 名字靠左，干支与「未填」标记靠右 */
  margin-right: auto;
}

.pillar-ganzhi {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 4rpx;
}

/* 时柱未填：干支仍显示（那是内部代入的值），但标出来不当作已知事实 */
.pillar-mark {
  margin-left: 12rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  padding: 2rpx 10rpx;
}

/* 时辰未填的说明：注解语气，压住四柱上方 */
.bazi-note {
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ochre);
  background: var(--paper-deep);
  border-radius: var(--r-sm);
}

.gan-zhi-row {
  display: flex;
  gap: 24rpx;
}

.gz-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: var(--paper);
  border-radius: 4rpx;
}

.gz-char {
  font-size: 48rpx;
  font-weight: 500;
  color: var(--ink);
}

.gz-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--card);
}
.gz-tag.wx-jin { background: var(--wx-jin); }
.gz-tag.wx-mu { background: var(--wx-mu); }
.gz-tag.wx-shui { background: var(--wx-shui); }
.gz-tag.wx-huo { background: var(--wx-huo); }
.gz-tag.wx-tu { background: var(--wx-tu); }

.gz-brief {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
}

.canggan {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.canggan-label {
  color: var(--ink-3);
  flex-shrink: 0;
}

.canggan-value {
  color: var(--ink-2);
}

.pillar-meaning {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.gz-detail {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.gz-detail-line {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

/* 五行详解 */
.wuxing-detail {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.wuxing-detail:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.wuxing-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.wuxing-name {
  flex-shrink: 0;
}

.wuxing-percent {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}

.wuxing-brief {
  font-size: 24rpx;
  color: var(--ink-2);
}

.wuxing-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 4rpx 16rpx;
  background: var(--paper);
  border-radius: 6rpx;
}

.wuxing-detail-text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* 喜用神详解 */
.xiyong-strength {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.strength-label {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}

.strength-ratio {
  font-size: 24rpx;
  color: var(--ink-3);
}

.xiyong-list {
  background: var(--paper);
  border-radius: 4rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.xiyong-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0;
}

.xiyong-label {
  font-size: 24rpx;
  color: var(--ink-3);
  flex-shrink: 0;
  width: 80rpx;
}

.xiyong-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.xiyong-explanation {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}
