/* 主页 · 山水泼墨
   结构：泼墨主视觉 → 站名 → 两张大功能卡 → 更多功能
   原则：主功能卡不挂小字说明；细分入口收进二级菜单。 */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 泼墨主视觉 ── */
.hero {
  width: 100%;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  display: block;
}

/* ── 站名（图下留白处，居中排版） ── */
.hero-copy {
  padding: 48rpx 40rpx 0;
  text-align: center;
}

.hero-title {
  font-family: var(--serif);
  font-size: 62rpx;
  font-weight: 500;
  letter-spacing: 18rpx;
  /* 末字字距补偿，视觉居中 */
  text-indent: 18rpx;
  color: var(--ink);
  line-height: 1.3;
}

.hero-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  color: var(--ink-3);
}

/* ── 两张大功能卡 ── */
.entry-grid {
  display: flex;
  padding: 64rpx 40rpx 0;
  gap: 20rpx;
}

.entry-card {
  flex: 1;
  height: 288rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-card:active {
  background: var(--paper-deep);
}

.entry-name {
  font-family: var(--serif);
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  color: var(--ink);
}

/* ── 更多功能 ── */
.more-link {
  margin-top: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--cinnabar);
  padding: 20rpx 0;
}

.more-link-hover {
  opacity: 0.6;
}

.more-arrow {
  margin-left: 8rpx;
  font-size: 30rpx;
  line-height: 1;
}
