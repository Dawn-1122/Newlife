/* 主页 · 门楼牌匾
   名堂 = 存放名字的殿堂：门楼悬匾，两扇对开门即两个主入口，推门入堂。
   铁律：主入口不挂说明小字；细分入口收进 pages/more。 */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 门楼主视觉 ── */
.gate {
  position: relative;
  width: 100%;
}

.gate-img {
  width: 100%;
  display: block;
}

/* 牌匾：叠印在插画门楣的留白匾上（网格定标 x 42.5-55.5% / y 49-60%，CSS 略出血盖住） */
.plaque {
  position: absolute;
  left: 42%;
  top: 48%;
  width: 15%;
  height: 12.5%;
  background: var(--plaque-wood);
  border: 1rpx solid var(--plaque-gold);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plaque-text {
  font-family: var(--serif);
  font-size: 26rpx;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  color: var(--plaque-gold);
  line-height: 1;
}

/* ── 两扇门（主入口） ── */
.doors {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  padding: 56rpx 40rpx 0;
}

.door {
  width: 240rpx;
  height: 280rpx;
  background: var(--card);
  border: 1rpx solid var(--cinnabar);
  border-radius: var(--r-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
}

.door-hover {
  background: var(--cinnabar-bg);
}

.door-studs {
  display: flex;
  gap: 16rpx;
}

.stud {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  border: 1rpx solid var(--cinnabar);
}

.door-name {
  font-family: var(--serif);
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
  color: var(--cinnabar);
}

/* ── slogan ── */
.slogan {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  color: var(--ink-3);
}

/* ── 文字入口（我的名字本 / 更多功能）── */
.links {
  margin-top: 72rpx;
}

.more-link {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--cinnabar);
  padding: 18rpx 0;
}

.more-link-hover {
  opacity: 0.6;
}

/* 名字本里的条数：是数据不是说明，压在墨阶里不抢视线 */
.link-count {
  margin-left: 10rpx;
  font-size: 22rpx;
  letter-spacing: 0;
  color: var(--ink-3);
}

.more-arrow {
  margin-left: 8rpx;
  font-size: 30rpx;
  line-height: 1;
}
