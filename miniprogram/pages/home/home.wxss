/* 首页 · 门楼水墨版式
   整个首页就是一幅门楼画：牌匾题「名堂」，左小人（书案+「起名」旗）= 起名入口，
   右小人（「释名」签+八卦布）= 释名入口。热区透明覆盖在画上，按压显淡朱细框。
   <image> 承载主视觉（WXSS 不支持本地背景图）。 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── 主视觉 + 双热区 ── */
.hero {
  position: relative;
}

.hero-img {
  display: block;
  width: 100%;
}

.hotspot {
  position: absolute;
  border: 2rpx solid transparent;
}

/* 左小人（书案 + 「起名」旗幡） */
.hotspot-left {
  left: 1%;
  bottom: 3%;
  width: 41%;
  height: 35%;
}

/* 右小人（「释名」签 + 八卦布） */
.hotspot-right {
  right: 1%;
  bottom: 1%;
  width: 43%;
  height: 39%;
}

/* 按压反馈：淡朱细框点睛 */
.hotspot-press {
  border-color: var(--cinnabar);
  background: var(--cinnabar-bg);
  opacity: 0.55;
}

/* ── 底部次级入口 ── */
.foot {
  padding: 36rpx 0 40rpx;
}

.foot-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.foot-link {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--cinnabar);
}

.foot-sep {
  font-size: 24rpx;
  color: var(--line-strong);
}
