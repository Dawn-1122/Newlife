.header {
  position: relative;
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.header-seal {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1F1F1F;
  letter-spacing: 8rpx;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", serif;
}

.subtitle {
  font-size: 28rpx;
  color: #5E7A73;
  margin-top: 8rpx;
}

.tagline {
  font-size: 24rpx;
  color: #9C9A92;
  margin-top: 12rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.entry-card {
  position: relative;
  width: 48%;
  background: #FCFAF5;
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entry-card.disabled {
  opacity: 0.55;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #1F1F1F, #3A3A3A);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.entry-desc {
  font-size: 22rpx;
  color: #9C9A92;
  margin-top: 8rpx;
  text-align: center;
}

.entry-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: #5E7A73;
  border-radius: 16rpx;
  padding: 4rpx 12rpx;
}

/* 更多入口 */
.more-section {
  margin-top: 8rpx;
}

.more-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 4rpx;
  color: #1F1F1F;
  font-size: 30rpx;
  font-weight: 600;
}

.more-arrow {
  font-size: 26rpx;
  color: #5E7A73;
  font-weight: 400;
}

.more-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.more-card {
  width: 31%;
  padding: 24rpx 16rpx;
}

.footer-note {
  text-align: center;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.footer-note text {
  font-size: 22rpx;
  color: #B2B0A8;
}
