<view class="page">
  <!-- 泼墨主视觉：图在上、字在下的「诗堂」版式，不叠印 -->
  <view class="hero">
    <image class="hero-img" src="/images/ink-hero.jpg" mode="widthFix" />
  </view>

  <view class="hero-copy">
    <view class="hero-title">名堂</view>
    <view class="hero-sub">有据可循的起名工具</view>
  </view>

  <!-- 两大主功能：不加小字说明，细分功能进二级菜单 -->
  <view class="entry-grid">
    <view class="entry-card" bindtap="onEntryTap" data-url="/pages/name/name">
      <view class="entry-name">起名</view>
    </view>
    <view class="entry-card" bindtap="onEntryTap" data-url="/pages/analyze/analyze">
      <view class="entry-name">名字测评</view>
    </view>
  </view>

  <!-- 更多功能 -->
  <view class="more-link" bindtap="onMoreTap" hover-class="more-link-hover">
    <text>更多功能</text>
    <text class="more-arrow">›</text>
  </view>
</view>
