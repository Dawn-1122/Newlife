<view class="page">
  <!-- 主视觉：门楼水墨画，两个小人即入口（左「起名」右「释名」透明热区） -->
  <view class="hero">
    <image class="hero-img" src="/images/home-hero.jpg" mode="widthFix" />

    <view class="hotspot hotspot-left" hover-class="hotspot-press" hover-stay-time="80"
          bindtap="onEntryTap" data-url="/pages/naming/naming" aria-label="起名" />
    <view class="hotspot hotspot-right" hover-class="hotspot-press" hover-stay-time="80"
          bindtap="onEntryTap" data-url="/pages/analyze/analyze" aria-label="释名" />
  </view>

  <!-- 底部次级入口 -->
  <view class="foot">
    <view class="foot-links">
      <text class="foot-link" bindtap="onBookTap">我的名字本</text>
      <text class="foot-sep">·</text>
      <text class="foot-link" bindtap="onMoreTap">更多功能</text>
    </view>
  </view>
</view>
