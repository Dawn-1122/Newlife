/**app.wxss**/

/* ══════════════════════════════════════════════════════════
   名堂 · 设计令牌（山水泼墨）
   改视觉只改这里 —— 页面样式一律引用变量，不写死颜色。
   墨阶：ink 浓 → ink-3 淡；朱砂只用于「选中 / 主行动 / 印章」三处。
   ══════════════════════════════════════════════════════════ */
page {
  --paper: #F3F1ED;
  --paper-deep: #EFEDE8;
  --card: #FFFFFF;
  --ink: #16181A;
  --ink-2: #4A4F55;
  --ink-3: #646A72;
  --line: #D6D3CB;
  --line-strong: #B4B0A8;
  --cinnabar: #A6321F;
  --cinnabar-bg: #FBF1EE;
  /* 赭黄：注解类文字（说明、降级提示）。与「五行·金」同色但语义不同 ——
     拆成两个令牌是为了将来单独调整其中之一时不互相牵连。 */
  --ochre: #75663F;
  /* 五行用传统矿物色（非 Material 色），供 .wuxing-* / .gz-tag / .bar-fill 等复用 */
  --wx-jin: #8D7B4F;
  --wx-mu: #4E6B54;
  --wx-shui: #3E5A73;
  --wx-huo: #A6321F;
  --wx-tu: #7A6248;
  --r-sm: 3rpx;
  --r-md: 6rpx;
  --serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;

  background-color: var(--paper);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

/* 无容器版式：泼墨页头等需要通栏时用 */
.container-flush {
  padding: 0;
  box-sizing: border-box;
}

/* ── 文字层级 ── */
.t-ink { color: var(--ink); }
.t-ink-2 { color: var(--ink-2); }
.t-ink-3 { color: var(--ink-3); }
.t-cinnabar { color: var(--cinnabar); }

.serif {
  font-family: var(--serif);
}

/* 标题：宋体 + 字距，代替旧版楷体 */
.h1 {
  font-family: var(--serif);
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.h2 {
  font-family: var(--serif);
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.h3 {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--ink);
}

/* 说明文字（克制使用：主页功能项一律不挂说明） */
.note {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 细分割线 */
.hairline {
  height: 1rpx;
  background: var(--line);
}

/* ── 卡片：去阴影、去大圆角，改用细线 + 留白分层 ── */
.card {
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: var(--r-md);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 无框区块（画册式版式，靠留白与细线分隔） */
.block {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}

/* ── 按钮 ── */
/* 微信 button 自带 ::after 描边与超大行高，会与本设计的细线体系打架 */
button::after {
  border: none;
}

.btn-primary {
  background: var(--ink);
  color: var(--paper);
  border: none;
  border-radius: 999rpx;
  padding: 26rpx 0;
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 500;
  letter-spacing: 4rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(22, 24, 26, 0.18);
}

.btn-primary:active {
  opacity: 0.9;
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 10rpx rgba(22, 24, 26, 0.14);
}

.btn-secondary {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  padding: 26rpx 0;
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(22, 24, 26, 0.08);
}

.btn-secondary:active {
  background: var(--paper-deep);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(22, 24, 26, 0.05);
}

/* 文字型动作（「修改」「更多功能 ›」） */
.btn-text {
  font-size: 26rpx;
  color: var(--cinnabar);
}

/* ── 分数徽章（墨阶替代彩色） ── */
.score-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--r-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.score-high { background: var(--cinnabar-bg); color: var(--cinnabar); }
.score-mid { background: var(--paper-deep); color: var(--ink-2); }
.score-low { background: var(--paper-deep); color: var(--ink-3); }

/* 徽章内「推荐值」标签与数字：标签弱化、数字加重，
   读起来是「推荐值 91」，而不是「推荐值91分」一串等重的字。 */
.score-label {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  margin-right: 8rpx;
  opacity: 0.8;
}

.score-num {
  font-family: var(--serif);
  font-size: 28rpx;
  font-weight: 600;
}

/* ── 朱砂印章 ── */
.seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: var(--cinnabar);
  color: var(--paper);
  border-radius: var(--r-sm);
  font-family: var(--serif);
  font-size: 44rpx;
}

/* ── 表单（沿用旧类名，换新令牌） ── */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child { border-bottom: none; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.form-input {
  font-size: 30rpx;
  color: var(--ink);
  height: 60rpx;
}

.picker-value {
  font-size: 30rpx;
  color: var(--ink);
  padding: 6rpx 0;
}

.chip-row {
  display: flex;
  gap: 16rpx;
}

.chip-row.wrap { flex-wrap: wrap; }

.chip {
  padding: 14rpx 32rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  color: var(--ink-2);
  background: transparent;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 自绘开关（替代原生 switch）：胶囊轨道 + 圆形滑块 ──
   关=浅灰轨道，开=墨色轨道，滑块纸白；用 border-radius 50% 做胶囊与圆 */
/* 开关：方角描边 + 墨块
   原先用 border-radius:50% 把 88×48 的盒子拉成椭圆，白点在浅底上几乎看不见，
   看着像一条空胶囊。改成与页面其它控件同一套直角语言：关=细线空框，开=墨色实心。 */
.switch {
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 84rpx;
  height: 44rpx;
  border-radius: var(--r-sm);
  /* 关：淡纸底 + 灰墨描边；开：实心墨 + 纸白点。
     关态若用 transparent，44rpx 高的细线在纸底上几乎看不见，像一处空白。 */
  background: var(--paper-deep);
  border: 1rpx solid var(--ink-3);
  transition: background 0.2s, border-color 0.2s;
}

.switch-knob {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 1rpx;
  background: var(--ink-2);
  transition: left 0.2s, background 0.2s;
}

.switch.on {
  background: var(--ink);
  border-color: var(--ink);
}

.switch.on .switch-knob {
  left: 45rpx;
  background: var(--paper);
}

/* ── 页头（无泼墨时的文字页头） ── */
.page-head {
  padding: 40rpx 0 30rpx;
}

/* 状态提示 */
.empty-hint,
.loading-hint {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ══════════════════════════════════════════════════════════
   浮层：日期弹层 / 时辰下拉
   ──────────────────────────────────────────────────────────
   为什么放在 app.wxss 而不是页面 styles/ 里再 @import：
   这两个浮层的**全部**观感都压在 position:fixed 上。一旦样式没生效，
   弹层就掉回文档流 —— 出生日期点开只是「页面底部多出一长串年份」，
   看起来像点了没反应。@import 属于编译期行为，页面样式表、构建工具、
   预览器三者谁少展开一次，用户就看到这个坏样子。app.wxss 每页必加载，
   没有这层不确定性；代价只是这两个组件类名全站唯一。
   ══════════════════════════════════════════════════════════ */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(22, 24, 26, 0.42);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  /* 兜底：无论 rpx 怎么换算、视口多矮，都不许把整屏顶满 */
  max-height: 80vh;
  background: var(--card);
  border-top: 1rpx solid var(--line-strong);
  padding-bottom: 30rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 40rpx;
  border-bottom: 1rpx solid var(--line);
}

.sheet-title {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.sheet-act {
  font-size: 27rpx;
  color: var(--ink-3);
  padding: 6rpx 8rpx;
}

.sheet-ok {
  color: var(--cinnabar);
}

/* 年 / 月 / 日 三个列头，与下面三列对齐 */
.sheet-units {
  display: flex;
  padding: 14rpx 0 6rpx;
}

.sheet-unit {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.sheet-cols {
  display: flex;
  height: 400rpx;
}

.sheet-col {
  flex: 1;
  height: 100%;
  -webkit-overflow-scrolling: touch;
}

/* 首尾衬垫：(400-76)/2 = 162rpx。
   没有它，最后一项（今年）只能贴在最底边，往上拖也没有余量 —— 看起来像
   「列表拖不动」。有了衬垫，今天总能落在列的正中间，上下都留出上下文。 */
.sheet-pad {
  height: 162rpx;
}

.sheet-item {
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink-2);
}

.sheet-item.on {
  color: var(--cinnabar);
  background: var(--cinnabar-bg);
  font-weight: 500;
}

/* 时辰用同一个弹层：只占一列，左「子时」右「23:00–01:00」。
   这一列占满整宽（不做居中窄列）：鼠标 / 手指落在两侧空白处滚不动，
   会被当成「列表不能滚」。 */
.sheet-cols-hour .sheet-col {
  flex: 1;
}

.sheet-item-hour {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
}

.sheet-item-hour .sheet-item-name {
  font-family: var(--serif);
  letter-spacing: 2rpx;
}

.sheet-item-hour .sheet-item-span {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.sheet-item-hour.on .sheet-item-span {
  color: var(--cinnabar);
}

/* 弹层底部的一句注解（目前只有时辰用到） */
.sheet-note {
  display: block;
  padding-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}
