/**app.wxss**/

/* ══════════════════════════════════════════════════════════
   名堂 · 设计令牌（山水泼墨）
   改视觉只改这里 —— 页面样式一律引用变量，不写死颜色。
   墨阶：ink 浓 → ink-3 淡；朱砂只用于「选中 / 主行动 / 印章」三处。
   ══════════════════════════════════════════════════════════ */
page {
  --paper: #F7F6F3;
  --paper-deep: #EFEDE8;
  --card: #FFFFFF;
  --ink: #16181A;
  --ink-2: #4A4F55;
  --ink-3: #8A9099;
  --line: #E4E2DD;
  --line-strong: #C9CDD2;
  --cinnabar: #A6321F;
  --cinnabar-bg: #FBF1EE;
  --r-sm: 3rpx;
  --r-md: 6rpx;
  --serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;

  background-color: var(--paper);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

/* 无容器版式：泼墨页头等需要通栏时用 */
.container-flush {
  padding: 0;
  box-sizing: border-box;
}

/* ── 文字层级 ── */
.t-ink { color: var(--ink); }
.t-ink-2 { color: var(--ink-2); }
.t-ink-3 { color: var(--ink-3); }
.t-cinnabar { color: var(--cinnabar); }

.serif {
  font-family: var(--serif);
}

/* 标题：宋体 + 字距，代替旧版楷体 */
.h1 {
  font-family: var(--serif);
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.h2 {
  font-family: var(--serif);
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.h3 {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--ink);
}

/* 说明文字（克制使用：主页功能项一律不挂说明） */
.note {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 细分割线 */
.hairline {
  height: 1rpx;
  background: var(--line);
}

/* ── 卡片：去阴影、去大圆角，改用细线 + 留白分层 ── */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 无框区块（画册式版式，靠留白与细线分隔） */
.block {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}

/* ── 按钮 ── */
/* 微信 button 自带 ::after 描边与超大行高，会与本设计的细线体系打架 */
button::after {
  border: none;
}

.btn-primary {
  background: var(--ink);
  color: var(--paper);
  border: none;
  border-radius: var(--r-sm);
  padding: 26rpx 0;
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 500;
  letter-spacing: 4rpx;
  text-align: center;
}

.btn-primary:active { opacity: 0.82; }

.btn-secondary {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  padding: 26rpx 0;
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: center;
}

.btn-secondary:active { background: var(--paper-deep); }

/* 文字型动作（「修改」「更多功能 ›」） */
.btn-text {
  font-size: 26rpx;
  color: var(--cinnabar);
}

/* ── 分数徽章（墨阶替代彩色） ── */
.score-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--r-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.score-high { background: var(--cinnabar-bg); color: var(--cinnabar); }
.score-mid { background: var(--paper-deep); color: var(--ink-2); }
.score-low { background: var(--paper-deep); color: var(--ink-3); }

/* ── 朱砂印章 ── */
.seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: var(--cinnabar);
  color: var(--paper);
  border-radius: var(--r-sm);
  font-family: var(--serif);
  font-size: 44rpx;
}

/* ── 表单（沿用旧类名，换新令牌） ── */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child { border-bottom: none; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.form-input {
  font-size: 30rpx;
  color: var(--ink);
  height: 60rpx;
}

.picker-value {
  font-size: 30rpx;
  color: var(--ink);
  padding: 6rpx 0;
}

.chip-row {
  display: flex;
  gap: 16rpx;
}

.chip-row.wrap { flex-wrap: wrap; }

.chip {
  padding: 14rpx 32rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-sm);
  font-size: 27rpx;
  color: var(--ink-2);
  background: transparent;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
}

/* ── 页头（无泼墨时的文字页头） ── */
.page-head {
  padding: 40rpx 0 30rpx;
}

/* 状态提示 */
.empty-hint,
.loading-hint {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
}
