/**app.wxss**/
page {
  background-color: #F4F0E7;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

/* 水墨配色变量 */
.bg-primary { background-color: #1F1F1F; }
.bg-secondary { background-color: #F4F0E7; }
.bg-card { background-color: #FCFAF5; }
.text-primary { color: #1F1F1F; }
.text-secondary { color: #5C5C5C; }
.text-accent { color: #5E7A73; }
.text-gold { color: #A93226; }

/* 卡片样式 */
.card {
  background: #FCFAF5;
  border: 1rpx solid #E2DED5;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
}

/* 按钮样式 */
.btn-primary {
  background: #1F1F1F;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次级按钮 */
.btn-secondary {
  background: #FCFAF5;
  color: #1F1F1F;
  border: 1rpx solid #1F1F1F;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-secondary:active {
  background: #F0EDE4;
}

/* 分数徽章 */
.score-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.score-high { background: #F5E4E1; color: #A93226; }
.score-mid { background: #E7ECE9; color: #5E7A73; }
.score-low { background: #ECEAE3; color: #8A867C; }

/* 水墨点睛：朱砂印章 + 书法标题 */
.seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: #A93226;
  color: #F4F0E7;
  border-radius: 10rpx;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", serif;
  font-size: 44rpx;
}

.serif {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", "Noto Serif SC", serif;
}
